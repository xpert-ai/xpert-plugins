{
  "compilerOptions": {
    "module": "CommonJS", "moduleResolution": "Node", "target": "ES2022",
    "rootDir": "src", "outDir": "dist", "declaration": true,
    "strict": true, "skipLibCheck": true, "experimentalDecorators": true,
    "emitDecoratorMetadata": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}

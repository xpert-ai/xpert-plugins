{
  "name": "@xpert-ai/plugin-analytics-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP analytics provider using platform-managed connections",
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.cjs",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "corepack pnpm run build && node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "AGPL-3.0",
  "private": true,
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "analytics_mcp"
    }
  },
  "peerDependencies": {
    "@xpert-ai/plugin-sdk": "^3.23.1",
    "@xpert-ai/contracts": "^3.23.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@xpert-ai/plugin-sdk": "^3.23.1",
    "@xpert-ai/contracts": "^3.23.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67",
    "typescript": "^5.9.2",
    "@types/node": "^20.19.9",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "zod-to-json-schema": "3.25.2"
  }
}

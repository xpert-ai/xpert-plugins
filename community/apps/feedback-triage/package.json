{
  "name": "@community/apps-feedback-triage",
  "version": "0.1.2",
  "private": true,
  "description": "Evidence-backed feedback triage with human approval in Xpert.",
  "author": "Kang Ningning",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/feedback-triage"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "docs",
    "env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-remote.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "test:workbench": "node --test scripts/workbench.e2e.mjs"
  },
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "feedback_triage"
    }
  },
  "peerDependencies": {
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.26.2",
    "@xpert-ai/plugin-sdk": "^3.26.2",
    "typeorm": "^0.3.28"
  },
  "dependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.26.2",
    "@xpert-ai/plugin-sdk": "3.26.2",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.27.0",
    "playwright-core": "1.61.0",
    "sql.js": "1.13.0",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.2"
  }
}

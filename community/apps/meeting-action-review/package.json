{
  "name": "@xpert-ai/plugin-meeting-action-review",
  "version": "0.1.5",
  "private": true,
  "description": "Meeting action extraction, human review and immutable confirmation workbench for Xpert.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "blueprints",
    "docs",
    "README.md"
  ],
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "meeting_action_review"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.remote.json",
    "build": "tsc && node scripts/build-remote.mjs && tsc -p tsconfig.remote.json && node scripts/verify-dist.mjs",
    "test": "vitest run tests/domain.test.ts && node --test tests/contracts.mjs",
    "test:postgres": "node --test tests/postgres.integration.mjs",
    "test:ui": "node scripts/verify-dist.mjs && playwright test",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "3.29.1",
    "@xpert-ai/plugin-sdk": "3.29.1",
    "typeorm": "^0.3.28",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/typeorm": "11.0.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "22.17.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@xpert-ai/contracts": "3.29.1",
    "@xpert-ai/plugin-sdk": "3.29.1",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "axios": "1.12.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.27.0",
    "i18next": "25.6.0",
    "lucide-react": "1.24.0",
    "pg": "8.16.3",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "short-unique-id": "4.4.4",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typeorm": "0.3.28",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "yaml": "2.9.0",
    "zod": "3.25.67"
  }
}

# Example only. Keep real values outside Git. The plugin does not load this file.
# Optional environment for the host's supported login/deployment tools.
# Browser archive installation uses normal browser sign-in instead.
XPERT_API_URL=http://127.0.0.1:3000
XPERT_USERNAME=
XPERT_PASSWORD=

# Only for tests/postgres.integration.mjs; use a dedicated disposable database.
# Tests reject database names other than meeting_review_test and reset that database.
MAR_TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@127.0.0.1:25433/meeting_review_test

# Optional installed Chrome for Playwright; omit to use its Chromium installation.
MAR_BROWSER_CHANNEL=chrome

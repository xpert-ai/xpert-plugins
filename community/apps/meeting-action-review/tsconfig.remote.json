{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "baseUrl": ".",
    "paths": {
      "@xpert-ai/plugin-shadcn-ui": [".cache/ui.ts"],
      "@xpert-ai/plugin-shadcn-ui/i18n": ["../../../packages/shadcn-ui/src/i18n.tsx"],
      "@xpert-ai/plugin-shadcn-ui/theme": ["../../../packages/shadcn-ui/src/theme.ts"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "*": ["node_modules/*"]
    }
  },
  "include": ["remote/**/*.ts", "remote/**/*.tsx"]
}

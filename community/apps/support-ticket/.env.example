# Support Ticket plugin - local install template.
# Copy the values into `community/.env` (never commit real tokens) and run the
# host helper from the Xpert backend repository:
#   pnpm plugin:install:local --workspace-path <this-plugin-dir> \
#     --org-id "$XPERT_ORG_ID" --token "$XPERT_TOKEN" --api-url "$XPERT_API_URL"
#
# The plugin itself reads no secrets at build time. Runtime configuration is
# resolved by the platform (model credentials) or through the plugin config form.

# Xpert backend origin used by the install helper.
XPERT_API_URL=

# Organization UUID that owns the install (this plugin declares level=organization).
XPERT_ORG_ID=

# Login JWT or API token of a user allowed to install plugins for that organization.
XPERT_TOKEN=

# Plugin config payload: {"aiTimeoutSeconds":90}
XPERT_PLUGIN_CONFIG_JSON=

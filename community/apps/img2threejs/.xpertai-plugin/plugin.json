{
  "name": "@xpert-ai/plugin-img2threejs",
  "version": "0.1.0",
  "description": "Quality-gated procedural Three.js TypeScript modeling from reference images.",
  "author": "XpertAI",
  "license": "AGPL-3.0",
  "artifactNamespace": "img2threejs",
  "skills": "./skills/",

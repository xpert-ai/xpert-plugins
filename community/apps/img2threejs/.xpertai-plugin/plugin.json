          },
          {
            "type": "assistant-template",
            "name": "img2threejs-modeling-assistant",
            "displayName": "Image to Three.js Modeling Assistant",
            "description": "Assistant template with the semantic modeling Skill and middleware tools."
          }
        ]
      }
    }

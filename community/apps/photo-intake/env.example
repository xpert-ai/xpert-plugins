# Merge these settings into community/.env. Never commit real local credentials.
XPERT_API_URL=http://localhost:3000/
XPERT_TOKEN=
XPERT_TENANT_ID=
# Runtime organization for the Assistant; deployment below explicitly uses tenant scope.
XPERT_ORG_ID=
XPERT_INSTALL_SCOPE=tenant
XPERT_PLUGIN_NAME=@community/apps-photo-intake
XPERT_PLUGIN_WORKSPACE_PATH=./apps/photo-intake
XPERT_PLUGIN_CONFIG_JSON={}

# 环境变量示例
#
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交。
#
# 说明：插件本身作为 Xpert 插件运行时不需要这些变量——模型由平台侧配置。
# 这里的变量只被本地验证脚本 scripts/analyze-resume.mjs 使用，
# 它的作用是绕过平台，用真实模型直接跑一遍抽取与评分规则，证明规则可执行。

# 必填。DeepSeek 开放平台的 API Key，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=

# 可选，默认 https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选，默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

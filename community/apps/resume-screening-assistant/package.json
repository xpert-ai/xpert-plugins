{
  "name": "@community/apps-resume-screening-assistant",
  "version": "0.1.0",
  "description": "Resume screening assistant Agentic App plugin for structured resume extraction, JD matching, recruiter review, and retryable screening records.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs",
    "prompts:export": "node scripts/export-prompts.mjs",
    "analyze:resume": "node scripts/analyze-resume.mjs",
    "lint": "echo \"(todo) add lint\"",
    "test": "tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.lib.json && node --test \"tests/**/*.test.mjs\"",
    "test:types": "tsc -p tsconfig.spec.json --noEmit",
    "test:unit": "node --test \"tests/**/*.test.mjs\""
  },
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "resume_screening"
    }
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.10.1",
    "@xpert-ai/plugin-sdk": "^3.10.1",
    "react": ">=18",
    "react-dom": ">=18",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@types/node": "^20.19.9",
    "@xpert-ai/contracts": "^3.10.1",
    "@xpert-ai/plugin-sdk": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24",
    "typescript": "^5.9.2",
    "zod": "3.25.67"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

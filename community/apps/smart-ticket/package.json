{
  "name": "@community/apps-smart-ticket",
  "version": "0.1.0",
  "description": "Smart customer feedback and ticket workbench with AI classification, response drafting, and human confirmation.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "smart_ticket"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "node --test tests/ticket.service.test.mjs tests/ticket.manifest.test.mjs"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.18.4",
    "@xpert-ai/plugin-sdk": "^3.18.4",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "22.18.6",
    "@xpert-ai/contracts": "3.18.4",
    "@xpert-ai/plugin-sdk": "3.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.24",
    "typescript": "^5.3.3",
    "zod": "3.25.67"
  }
}

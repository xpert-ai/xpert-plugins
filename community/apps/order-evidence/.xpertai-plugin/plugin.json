              "presentation": {
                "tagline": {
                  "en_US": "One order. Connected collaboration.",
                  "zh_Hans": "一张订单，贯通协作。"
                },
                "longDescription": {
                  "en_US": "Connect contract, engineering, procurement, production, quality and after-sales evidence around one manufacturing order. A coordinator and six specialist Assistants work through four explicit Routers and six human decisions in a native Project Pipeline.",
                  "zh_Hans": "围绕一张制造业订单关联合同、工程、采购、计划、质量与售后证据。一个协调者与六个专业 Assistant 通过四个 Router 和六个人工决定节点，在原生项目流水线中推进工作。"
                },
                "developer": "XpertAI",
                "screenshots": [
                  "./assets/brand/order-evidence-cover-zh-v1.png"
                ],
                "features": [
                  {
                    "key": "specialist-assistants",
                    "title": {
                      "en_US": "Six specialist roles",
                      "zh_Hans": "六个专业角色"
                    },
                    "description": {
                      "en_US": "Separate specialist work across contract, engineering, procurement, production planning, quality and after-sales.",
                      "zh_Hans": "合同、工程、采购、计划、质量与售后 Assistant 各自审阅证据、提出建议。"
                    }
                  },
                  {
                    "key": "evidence-routing",
                    "title": {
                      "en_US": "Evidence-based routing",
                      "zh_Hans": "按证据条件路由"
                    },
                    "description": {
                      "en_US": "Four Routers check requirements, supply readiness, quality evidence and follow-up improvement; missing evidence blocks progression.",
                      "zh_Hans": "四个 Router 检查要求资料、供应条件、质量证据与后续改进；条件不足时等待补证。"
                    }
                  },
                  {
                    "key": "human-accountability",
                    "title": {
                      "en_US": "Accountable human decisions",
                      "zh_Hans": "人类负责关键决定"
                    },
                    "description": {
                      "en_US": "Configured responsible users confirm each stage against the exact recommendation version.",
                      "zh_Hans": "配置的责任人逐阶段确认准确版本的建议，能力使用权与业务批准权分开。"
                    }
                  },
                  {
                    "key": "evidence-traceability",
                    "title": {
                      "en_US": "Traceable evidence and history",
                      "zh_Hans": "证据与履历可追溯"
                    },
                    "description": {
                      "en_US": "Retain evidence versions, Assistant work and human decisions in the order Project.",
                      "zh_Hans": "在订单项目中保留证据版本、Assistant 工作与人工决定，便于复核和追溯。"
                    }
                  }
                ],
                "useCases": [
                  {
                    "en_US": "Order requirement clarification",
                    "zh_Hans": "订单要求澄清"
                  },
                  {
                    "en_US": "BOM and supply readiness review",
                    "zh_Hans": "BOM 与物料齐套复核"
                  },
                  {
                    "en_US": "Quality release and after-sales improvement review",
                    "zh_Hans": "质量放行与售后改进复核"
                  }
                ],
                "dataScope": {
                  "en_US": "Access follows organization, workspace and Project permissions. This demo uses synthetic business snapshots and local decisions; it does not call SAP or Data Xpert or create production transactions.",
                  "zh_Hans": "访问遵循组织、工作空间及项目权限。当前演示使用合成业务快照与本地决定记录，不调用 SAP 或 Data Xpert，不产生生产交易。"
                },
                "initializationSummary": {
                  "en_US": "Prepare a dedicated workspace and publish the coordinator and six specialists. Before running a Project, bind the published role members and assign authorized human approvers for each stage.",
                  "zh_Hans": "准备专用工作空间并发布协调者与六个专业 Assistant。运行项目前，需绑定已发布的角色成员，并为各阶段配置具备权限的人类批准人。"
                },
                "initializationSteps": [
                  {
                    "en_US": "Check an available primary model.",
                    "zh_Hans": "检查可用主模型。"
                  },
                  {
                    "en_US": "Create the dedicated application workspace.",
                    "zh_Hans": "创建应用专用工作空间。"
                  },
                  {
                    "en_US": "Install and publish seven Assistant roles.",
                    "zh_Hans": "安装并发布七个 Assistant 角色。"
                  }
                ]
              },
              "entry": {
                "type": "assistant-chat"
              }

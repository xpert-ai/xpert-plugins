    "reflect-metadata": "0.2.2",
    "typescript": "5.9.2",
    "tsx": "4.20.5",
    "esbuild": "0.25.10",
    "@types/node": "22.18.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "sql.js": "1.13.0",
    "i18next": "25.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "radix-ui": "^1.6.2",

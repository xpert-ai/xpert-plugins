{
  "name": "@community/apps-shadow-research",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-bound A-share research experiments for the Xpert Workbench",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@8.15.8",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "shadow_research"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-remote.mjs",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.remote.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.18.4",
    "@xpert-ai/plugin-sdk": "^3.18.4",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",

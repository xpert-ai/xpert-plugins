# 复制到 Git 仓库外的私有目录，填写实际值后在当前终端加载。
# 本文件用于部署和按需运行的验收脚本；插件运行时不读取此文件。
XPERT_API_ORIGIN=http://localhost:3000
XPERT_API_URL=http://localhost:3000/api
DEFECT_INTAKE_PLUGIN_DIR=/absolute/path/to/xpert-plugins/community/apps/defect-intake

# 用于本地部署与验收的正常平台登录身份，真实值不得提交到 Git。
XPERT_USERNAME=
XPERT_PASSWORD=
# 系统级插件安装到 Default tenant；租户 ID 来自正常的平台初始化结果。
XPERT_TENANT_ID=

# 在组织中安装并发布助手后，填写实际组织和助手 ID。
XPERT_ORG_ID=
XPERT_ASSISTANT_ID=

# 仅用于 tests/access-live.mjs：同租户、同组织中的普通 APP_USER 账号，
# 并已通过平台正常分享获得本课题已发布助手的使用权。
XPERT_SECOND_USERNAME=
XPERT_SECOND_PASSWORD=

# 可选的验收回执路径必须指向仓库外的私有目录。
# XPERT_AI_LIVE_RECEIPT=/absolute/private/path/analysis.json
# XPERT_ACCESS_LIVE_RECEIPT=/absolute/private/path/access.json

# 模型 API 密钥只配置在平台提供商连接中，无需填写在本文件里。

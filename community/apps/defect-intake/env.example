# Copy to a private directory outside Git, fill in values, and load in your shell.
# This file is for deployment / opt-in acceptance scripts, not plugin runtime.
XPERT_API_ORIGIN=http://localhost:3000
XPERT_API_URL=http://localhost:3000/api
DEFECT_INTAKE_PLUGIN_DIR=/absolute/path/to/xpert-plugins/community/apps/defect-intake

# Normal platform login for local deployment and acceptance. Never commit values.
XPERT_USERNAME=
XPERT_PASSWORD=
# Default tenant ID for this system-level plugin. Obtain from normal platform setup.
XPERT_TENANT_ID=

# Populate after installing and publishing the Assistant in an organization.
XPERT_ORG_ID=
XPERT_ASSISTANT_ID=

# Only for tests/access-live.mjs: ordinary APP_USER in the same tenant/organization,
# with normal platform sharing access to the published exam Assistant.
XPERT_SECOND_USERNAME=
XPERT_SECOND_PASSWORD=

# Optional receipt paths must point to a private directory outside the repository.
# XPERT_AI_LIVE_RECEIPT=/absolute/private/path/analysis.json
# XPERT_ACCESS_LIVE_RECEIPT=/absolute/private/path/access.json

# Model API keys belong in the platform provider connection, not in this file.

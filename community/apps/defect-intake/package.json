{
  "name": "@community/apps-defect-intake",
  "version": "0.2.2",
  "description": "AI-assisted ticket information completion with human review for Xpert.",
  "license": "AGPL-3.0",
  "author": "YumiCornzheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/defect-intake"
  },
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "defect_intake"
    }
  },
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.cjs",
    "README.md",
    "docs",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build:ui": "pnpm --filter @xpert-ai/plugin-shadcn-ui build",
    "build": "pnpm run build:ui && pnpm run typecheck && node scripts/build.mjs && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.remote.json --noEmit",
    "test": "pnpm run typecheck && node --test tests/*.test.cjs",
    "verify:dist": "node scripts/build.mjs --check"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.30.2",
    "@xpert-ai/plugin-sdk": "^3.30.2",
    "typeorm": "^0.3.24",
    "zod": "3.25.67",
    "@langchain/core": ">=0.3.68 <0.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "3.30.2",
    "@xpert-ai/plugin-sdk": "3.30.2",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "@types/node": "22.18.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24",
    "typescript": "^5.9.2",
    "zod": "3.25.67",
    "lucide-react": "1.24.0",
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "@langchain/core": "0.3.72"
  },
  "publishConfig": {
    "access": "public"
  }
}

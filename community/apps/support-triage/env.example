# Credentials belong in the current process or an approved secret store.
# Copy only to an ignored local environment when explicitly choosing that method.
# Never commit populated secrets.
XPERT_API_URL=http://localhost:3000
XPERT_USERNAME=
XPERT_PASSWORD=
XPERT_TENANT_ID=

# Optional plugin debug: tool name and timing only, no business content.
SUPPORT_TRIAGE_DEBUG=false

# Windows restricted-shell build fallback; not needed by the Xpert runtime.
TRIAGE_ESBUILD_WASM=0

# Configure OpenAI-compatible provider URL, model name and API key in Xpert.
# This plugin has no OPENAI_API_KEY setting and never receives the model key.

{
  "name": "@community/apps-support-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "description": "Customer support intake, AI triage and human review in Xpert Workbench.",
  "packageManager": "pnpm@8.15.8",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }, "./package.json": "./package.json" },
  "files": ["dist", "docs", "README.md", "THIRD_PARTY_NOTICES.md"],
  "xpert": { "plugin": { "level": "system", "artifactNamespace": "support_triage" } },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.remote.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "tsx --test tests/*.test.ts",
    "verify:dist": "node scripts/build.mjs --check",
    "preview": "tsx scripts/preview.ts"
  },
  "pnpm": { "packageExtensions": {
    "@xpert-ai/contracts@3.29.0": { "dependencies": { "short-unique-id": "5.3.2" } },
    "@xpert-ai/plugin-sdk@3.29.0": { "dependencies": { "axios": "1.12.2" } }
  } },
  "peerDependencies": {
    "@langchain/core": "^0.3.72", "@nestjs/common": "^11.1.6", "@nestjs/core": "^11.1.6", "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.29.0", "@xpert-ai/plugin-sdk": "^3.29.0", "typeorm": "^0.3.24", "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72", "@nestjs/common": "11.1.6", "@nestjs/core": "11.1.6", "@nestjs/cqrs": "11.0.3", "@nestjs/typeorm": "11.0.0",
    "@types/node": "^22.18.6", "@types/react": "^18.3.24", "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.29.0", "@xpert-ai/plugin-sdk": "3.29.0", "@xpert-ai/plugin-shadcn-ui": "link:../../../packages/shadcn-ui",
    "@tailwindcss/cli": "^4.3.2", "tailwindcss": "^4.3.2", "esbuild": "0.25.10", "react": "18.3.1", "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2", "sql.js": "^1.13.0", "tsx": "4.20.5", "typeorm": "0.3.24", "typescript": "5.9.2", "zod": "3.25.67"
  }
}

{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "skipLibCheck": true, "esModuleInterop": true, "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "declaration": true, "outDir": "dist", "rootDir": "src", "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"], "exclude": ["src/remote"]
}

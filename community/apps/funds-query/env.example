# Optional server-side overrides, read when the plugin is loaded.
# The graphical plugin configuration takes precedence for explicit saved settings.
FUNDS_QUERY_PYTHON=auto
# Use an absolute writable path on the API server when overriding the default.
# FUNDS_QUERY_DATA_DIR=/absolute/persistent/funds-query

# Development only, used to create the plugin virtual environment.
# FUNDS_QUERY_BASE_PYTHON=python3.12

# Browser regression executable, optional outside macOS.
# FUNDS_QUERY_BROWSER=/absolute/path/to/chrome

# Required for archive-parser regression if the platform is not a sibling named xpert.
# XPERT_PLATFORM_ROOT=/absolute/path/to/xpert

# Credentials and model keys are managed by Xpert, independently of this file.

diff --git a/tools/scripts/start-api.test.mjs b/tools/scripts/start-api.test.mjs
index df1fb8e7b..62a341131 100644
--- a/tools/scripts/start-api.test.mjs
+++ b/tools/scripts/start-api.test.mjs
@@ -290,3 +290,60 @@ test(
     }
   }
 )
+
+
+test('an explicit platform restart request reruns the full startup gate and reloads the API', async () => {
+  const fixture = recordRuns()
+  let served = 0
+  await runApiWorkflow({
+    ...fixture,
+    run: async (command, args, options) => {
+      await fixture.run(command, args, options)
+      if (args.length === 1 && args[0].endsWith('main.js') && served++ === 0)
+        return { runtimeRestartRequested: true }
+    }
+  })
+  const expected = ['pnpm b:p:all', 'pnpm nx build api --configuration=development', 'apply', 'verify', 'serve']
+  assert.deepEqual(actions(fixture.calls), [...expected, ...expected])
+})
+
+test('stopping the startup workflow prevents automatic restart of a SIGTERM child', async () => {
+  const controller = new AbortController()
+  const fixture = recordRuns()
+  await assert.rejects(runApiWorkflow({
+    ...fixture, signal: controller.signal,
+    run: async (command, args, options) => {
+      await fixture.run(command, args, options)
+      if (args.length === 1 && args[0].endsWith('main.js')) {
+        controller.abort(new Error('Stopped by user'))
+        throw new Error('Stopped by user')
+      }
+    }
+  }), /Stopped by user/)
+  assert.equal(fixture.calls.length, 5)
+})
+
+
+test('the platform signaler reports explicit restart intent through private IPC before graceful exit', async () => {
+  const directory = await mkdtemp(path.join(tmpdir(), 'xpert-restart-ipc-'))
+  try {
+    const require = createRequire(import.meta.url)
+    const compiled = require('esbuild').buildSync({
+      entryPoints: [path.resolve('packages/server/src/runtime-control/runtime-process-signaler.ts')],
+      bundle: true, write: false, format: 'cjs', platform: 'node'
+    }).outputFiles[0].text
+    const moduleFile = path.join(directory, 'signaler.cjs')
+    await writeFile(moduleFile, compiled)
+    const program = `process.on('SIGTERM', () => process.exit(0));require(${JSON.stringify(moduleFile)}).signalRuntimeProcess('SIGTERM')`
+    const result = await runCommand(process.execPath, ['-e', program], {
+      cwd: directory, env: process.env, stdio: 'ignore', runtimeRestartIpc: true
+    })
+    assert.deepEqual(result, { runtimeRestartRequested: true })
+  } finally { await rm(directory, { recursive: true, force: true }) }
+})
+
+test('clean exits and unexpected signals without platform IPC do not request a restart', async () => {
+  const options = { cwd: process.cwd(), env: process.env, stdio: 'ignore', runtimeRestartIpc: true }
+  assert.equal(await runCommand(process.execPath, ['-e', 'process.exit(0)'], options), undefined)
+  await assert.rejects(runCommand(process.execPath, ['-e', "process.kill(process.pid, 'SIGTERM')"], options), /SIGTERM/)
+})

 export const RUNTIME_PROCESS_SIGNALER = Symbol('RUNTIME_PROCESS_SIGNALER')
+
+/** Notify the local source supervisor before the platform-requested shutdown. */
+export function signalRuntimeProcess(signal: 'SIGTERM'): void {
+	if (process.connected && process.send) {
+		process.send({ type: 'xpert.runtime.restart' }, () => process.kill(process.pid, signal))
+		return
+	}
+	process.kill(process.pid, signal)
+}

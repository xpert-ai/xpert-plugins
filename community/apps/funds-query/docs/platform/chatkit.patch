@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { readAssistantChatContext } from './assistant-chat-context';
+
+const source = {
+  conversationId: 'conversation',
+  threadId: 'thread',
+  runtimeScopeReady: true,
+  historyLoad: { threadId: 'thread', status: 'loaded' as const },
+};
+
+describe('assistant context receipt', () => {
+  it('confirms the active ready conversation', () => {
+    expect(readAssistantChatContext(source)).toEqual({
+      success: true,
+      conversationId: 'conversation',
+      threadId: 'thread',
+      ready: true,
+    });
+  });
+  it.each(['loading', 'error'] as const)(
+    'waits while history is %s',
+    (status) => {
+      expect(
+        readAssistantChatContext({
+          ...source,
+          historyLoad: { threadId: 'thread', status },
+        }).ready,
+      ).toBe(false);
+    },
+  );
+  it('waits while the authorization scope is changing', () => {
+    expect(
+      readAssistantChatContext({ ...source, runtimeScopeReady: false }).ready,
+    ).toBe(false);
+  });
+});

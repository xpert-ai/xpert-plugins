@@ -0,0 +1,17 @@
+import type { XpertExtensionViewManifest } from '@xpert-ai/xpert-sdk';
+
+// This optional presentation field also works with SDK versions that predate it.
+export type ComposerViewManifest = XpertExtensionViewManifest & {
+  workbench?: XpertExtensionViewManifest['workbench'] & {
+    composerOwner?: 'host' | 'view';
+  };
+};
+
+export function viewOwnsComposer(
+  view: ComposerViewManifest | null,
+  activeViewKey: string | null,
+) {
+  return (
+    view?.key === activeViewKey && view?.workbench?.composerOwner === 'view'
+  );
+}

--- /dev/null
+++ b/packages/chatkit-ui/browser-tests/composer-owner.spec.ts
@@ -0,0 +1,187 @@
+import { readFile } from 'node:fs/promises';
+import { dirname, extname, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { expect, test } from '@playwright/test';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const hostOrigin = 'http://localhost';
+const key = 'funds.view-provider__funds-query';
+const manifest = {
+  key,
+  title: 'Funds query',
+  hostType: 'agent',
+  slot: 'agent.workbench.fixed',
+  source: { provider: 'funds' },
+  workbench: { openMode: 'auto', composerOwner: 'view' },
+  clientCommands: [
+    { key: 'assistant.chat.get_context' },
+    { key: 'assistant.chat.send_message' },
+  ],
+  dataSource: { mode: 'platform' },
+  view: {
+    type: 'remote_component',
+    runtime: 'vue',
+    protocolVersion: 1,
+    component: { isolation: 'iframe', entry: 'funds' },
+    dataSource: { mode: 'platform' },
+  },
+};
+const remote = `<!doctype html><html><body>
+<label>Funds question<textarea aria-label="Funds question"></textarea></label>
+<button id="context" disabled>Read context</button><button id="stale" disabled>Stale send</button><output id="result"></output>
+<script>
+let context, readTimer;
+addEventListener('message',event=>{const message=event.data;
+ if(message.type==='init'){context=message;document.querySelector('#context').disabled=false;document.querySelector('#stale').disabled=false;}
+ if(message.type==='hostEvent'&&message.event?.type==='view.context.changed'&&context)context.scopeRevision=message.scopeRevision;
+ if(message.type==='error'&&message.code==='context_changed'&&context){context.scopeRevision=message.scopeRevision;setTimeout(()=>document.querySelector('#context').click(),150);}
+ if(message.type==='clientCommandResult'){if(message.result?.success&&'ready' in message.result)clearTimeout(readTimer);document.querySelector('#result').textContent=JSON.stringify(message.result);}
+});
+function command(key,payload){parent.postMessage({channel:'xpertai.remote_component',protocolVersion:1,instanceId:context.instanceId,scopeRevision:context.scopeRevision,type:'invokeClientCommand',requestId:crypto.randomUUID(),commandKey:key,payload},'*')}
+document.querySelector('#context').onclick=()=>{command('assistant.chat.get_context',{});clearTimeout(readTimer);readTimer=setTimeout(()=>document.querySelector('#context').click(),1500)};
+document.querySelector('#stale').onclick=()=>command('assistant.chat.send_message',{text:'wrong context',conversationId:'another',threadId:'another'});
+parent.postMessage({channel:'xpertai.remote_component',protocolVersion:1,type:'ready'},'*');
+</script></body></html>`;
+
+for (const { width, frameOrigin } of [
+  { width: 1500, frameOrigin: hostOrigin },
+  { width: 760, frameOrigin: hostOrigin },
+  { width: 1500, frameOrigin: 'http://127.0.0.1' },
+]) {
+  test(`view composer is exclusive and native drafts recover at ${width}px from ${frameOrigin}`, async ({
+    page,
+  }, testInfo) => {
+    const errors: string[] = [];
+    page.on('pageerror', (error) => errors.push(error.message));
+    const host = `<!doctype html><html><body style="margin:0;height:100vh">
+<script src="/web-component.js"></script><script>
+const element=document.createElement('xpertai-chatkit');
+element.style.cssText='display:block;width:100vw;height:100vh';
+let view={viewKey:'${key}',layout:'maximized'};
+function apply(){element.setOptions({frameUrl:'${frameOrigin}/index.html',sessionKey:'composer-test',
+api:{apiUrl:'${hostOrigin}/api/ai',xpertId:'assistant',getClientSecret:async()=>({secret:'fixture-secret',organizationId:'fixture-org'})},
+initialThread:null,workbench:{enabled:true,navigation:{projectId:null,view}}});}
+window.showNativeChat=()=>{view=null;apply()};
+window.showFunds=()=>{view={viewKey:'${key}',layout:'maximized'};apply()};
+apply();document.body.append(element);
+</script></body></html>`;
+    await page.route('**/*', async (route) => {
+      const url = new URL(route.request().url());
+      if (![hostOrigin, frameOrigin].includes(url.origin)) return route.abort();
+      if (url.pathname === '/host')
+        return route.fulfill({ contentType: 'text/html', body: host });
+      if (url.pathname === '/web-component.js')
+        return route.fulfill({
+          contentType: 'application/javascript',
+          body: await readFile(
+            resolve(root, '../web-component/dist/xpert-chatkit.js'),
+          ),
+        });
+      const headers = {
+        'access-control-allow-origin': frameOrigin,
+        'access-control-allow-headers': '*',
+        'access-control-allow-methods': 'GET,POST,OPTIONS',
+      };
+      if (route.request().method() === 'OPTIONS')
+        return route.fulfill({ status: 204, headers });
+      if (url.pathname.includes('/api/')) {
+        if (url.pathname.endsWith('/views'))
+          return route.fulfill({ json: [manifest], headers });
+        if (url.pathname.endsWith('/manifest'))
+          return route.fulfill({ json: manifest, headers });
+        if (url.pathname.endsWith('/remote-component/entry'))
+          return route.fulfill({
+            contentType: 'text/html',
+            body: remote,
+            headers,
+          });
+        if (url.pathname.endsWith('/assistants/assistant'))
+          return route.fulfill({
+            json: {
+              assistant_id: 'assistant',
+              name: 'Funds assistant',
+              config: {},
+            },
+            headers,
+          });
+        return route.fulfill({
+          json: { items: [], data: [], total: 0 },
+          headers,
+        });
+      }
+      const file = resolve(
+        root,
+        'dist/app',
+        `.${decodeURIComponent(url.pathname)}`,
+      );
+      if (!file.startsWith(resolve(root, 'dist/app') + sep))
+        return route.abort();
+      try {
+        const types: Record<string, string> = {
+          '.html': 'text/html',
+          '.js': 'application/javascript',
+          '.css': 'text/css',
+          '.woff2': 'font/woff2',
+          '.svg': 'image/svg+xml',
+          '.png': 'image/png',
+        };
+        return route.fulfill({
+          contentType: types[extname(file)] ?? 'application/octet-stream',
+          body: await readFile(file),
+        });
+      } catch {
+        return route.fulfill({ status: 404, body: 'No fixture resource' });
+      }
+    });
+    await page.setViewportSize({ width, height: 950 });
+    await page.goto(`${hostOrigin}/host`);
+    const chatkit = page.frameLocator('xpertai-chatkit iframe');
+    const funds = chatkit.frameLocator('iframe[title="Funds query"]');
+    await expect(
+      funds.getByRole('textbox', { name: 'Funds question' }),
+    ).toBeVisible();
+    await expect(async () => {
+      await funds.getByRole('button', { name: 'Read context' }).click();
+      await expect(funds.locator('#result')).toContainText('"success":true', {timeout: 1000});
+    }).toPass({timeout: 10000, intervals: [150, 300, 500]});
+    await expect(funds.locator('#result')).toContainText(
+      '"conversationId":null',
+    );
+    await funds.getByRole('button', { name: 'Stale send' }).click();
+    await expect(funds.locator('#result')).toContainText('stale_context');
+    const nativeDock = chatkit.locator('[data-slot="chatkit-chat-composer"]');
+    await expect(nativeDock).toHaveCount(1);
+    const nativeInput = nativeDock.getByRole('textbox', {
+      includeHidden: true,
+    });
+    await expect(nativeInput).toHaveCount(1);
+    await expect(nativeInput).not.toBeVisible();
+    await chatkit
+      .getByRole('button', { name: /^Open conversation input:/ })
+      .click();
+    await expect(nativeInput).not.toBeVisible();
+    await page.evaluate(() =>
+      (window as Window & { showNativeChat(): void }).showNativeChat(),
+    );
+    await expect(nativeDock).toBeVisible();
+    await nativeInput.fill('Native draft is preserved');
+    await page.evaluate(() =>
+      (window as Window & { showFunds(): void }).showFunds(),
+    );
+    await expect(
+      funds.getByRole('textbox', { name: 'Funds question' }),
+    ).toBeVisible();
+    await expect(nativeInput).not.toBeVisible();
+    await expect(nativeInput).toHaveText('Native draft is preserved');
+    await page.screenshot({
+      path: testInfo.outputPath('one-composer.png'),
+      fullPage: true,
+    });
+    await page.evaluate(() =>
+      (window as Window & { showNativeChat(): void }).showNativeChat(),
+    );
+    await expect(nativeDock).toBeVisible();
+    await expect(nativeInput).toHaveText('Native draft is preserved');
+    expect(errors).toEqual([]);
+  });
+}

+import { describe, expect, it } from 'vitest';
+import {
+  fixture as f,
+  setupWorkbenchTests,
+} from './WorkbenchShell.test-fixture';
+
+setupWorkbenchTests();
+
+async function open() {
+  f.mocks.listSlotViews.mockResolvedValue([f.manifest]);
+  f.mocks.submit.mockResolvedValue(undefined);
+  f.render(
+    <f.WorkbenchShell
+      options={{ ...f.baseOptions, workbench: { enabled: true } }}
+      locale="en-US"
+      onRequestContextChange={() => undefined}
+    >
+      <f.WorkbenchToggleButton />
+    </f.WorkbenchShell>,
+  );
+  await f.waitFor(() =>
+    expect(f.screen.getByLabelText('Open views')).toBeEnabled(),
+  );
+  f.fireEvent.click(f.screen.getByLabelText('Open views'));
+  await f.waitFor(() => expect(f.mocks.remoteViewProps).not.toBeNull());
+  return f.mocks.remoteViewProps!.onClientCommand;
+}
+
+describe('targeted assistant messages', () => {
+  it('reads current context without forwarding navigation or submitting a message', async () => {
+    const command = await open();
+    let result;
+    await f.act(async () => {
+      result = await command('assistant.chat.get_context', {}, f.manifest);
+    });
+    expect(result).toEqual({
+      success: true,
+      conversationId: 'conversation-1',
+      threadId: 'thread-1',
+      ready: true,
+    });
+    expect(f.mocks.submit).not.toHaveBeenCalled();
+  });
+  it('rejects a message whose expected conversation is no longer active', async () => {
+    const command = await open();
+    let result;
+    await f.act(async () => {
+      result = await command(
+        'assistant.chat.send_message',
+        { text: 'followup', conversationId: 'other', threadId: 'thread-1' },
+        f.manifest,
+      );
+    });
+    expect(result).toEqual({ success: false, code: 'stale_context' });
+    expect(f.mocks.submit).not.toHaveBeenCalled();
+  });
+  it('submits a message only to its confirmed active conversation', async () => {
+    const command = await open();
+    let result;
+    await f.act(async () => {
+      result = await command(
+        'assistant.chat.send_message',
+        {
+          text: 'followup',
+          conversationId: 'conversation-1',
+          threadId: 'thread-1',
+        },
+        f.manifest,
+      );
+    });
+    expect(result).toMatchObject({ success: true, status: 'sent' });
+    expect(f.mocks.submit).toHaveBeenCalledTimes(1);
+  });
+});

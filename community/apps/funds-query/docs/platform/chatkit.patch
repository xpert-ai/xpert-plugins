+      >
+        <input aria-label="Native input" defaultValue="Saved draft" />
+      </ChatComposerFormFrame>
+    </>
+  );
+}
+
+function tree() {
+  return (
+    <WorkbenchShell
+      options={{ ...baseOptions, workbench: { enabled: true } }}
+      locale="en-US"
+      onRequestContextChange={() => undefined}
+    >
+      <MainChat />
+    </WorkbenchShell>
+  );
+}
+
+async function openView() {
+  setObservedWidth(1200);
+  await waitFor(() =>
+    expect(screen.getByLabelText('Open views')).toBeEnabled(),
+  );
+  fireEvent.click(screen.getByLabelText('Open views'));
+  await screen.findByTestId('remote-view');
+  fireEvent.click(screen.getByLabelText('Expand panel'));
+}
+
+describe('View-owned conversation composer', () => {
+  setupWorkbenchTests();
+
+  it('requires explicit ownership on the exact active view', () => {
+    const view: ComposerViewManifest = {
+      ...manifest,
+      workbench: { ...manifest.workbench, composerOwner: 'view' },
+    };
+    expect(viewOwnsComposer(view, view.key)).toBe(true);
+    expect(viewOwnsComposer(view, 'main-chat')).toBe(false);
+    expect(viewOwnsComposer(manifest, manifest.key)).toBe(false);
+  });
+
+  it('hides the mounted native input and restores its draft in the main conversation', async () => {
+    mocks.listSlotViews.mockResolvedValue([
+      {
+        ...manifest,
+        workbench: { ...manifest.workbench, composerOwner: 'view' },
+      },
+    ]);
+    render(tree());
+    const native = screen.getByLabelText('Native input');
+    fireEvent.change(native, { target: { value: 'Keep this draft' } });
+    await openView();
+    expect(native).not.toBeVisible();
+    expect(native).toBeInTheDocument();
+    fireEvent.click(screen.getByRole('tab', { name: 'Chat' }));
+    expect(native).toBeVisible();
+    expect(native).toHaveValue('Keep this draft');
+  });
+
+  it('keeps the input for ordinary views', async () => {
+    mocks.listSlotViews.mockResolvedValue([manifest]);
+    render(tree());
+    await openView();
+    expect(screen.getByLabelText('Native input')).toBeVisible();
+  });
+});

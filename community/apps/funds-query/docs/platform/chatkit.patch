@@ -0,0 +1,28 @@
+import type { WorkbenchRuntime } from './WorkbenchRuntime';
+
+/** Read-only context receipt. Requested IDs are preconditions, never authorization. */
+export type AssistantChatContextResult = {
+  success: true;
+  conversationId: string | null;
+  threadId: string | null;
+  ready: boolean;
+};
+
+export const ASSISTANT_CHAT_GET_CONTEXT_COMMAND = 'assistant.chat.get_context';
+
+export function readAssistantChatContext(
+  source: Pick<
+    WorkbenchRuntime,
+    'conversationId' | 'threadId' | 'runtimeScopeReady' | 'historyLoad'
+  >,
+): AssistantChatContextResult {
+  return {
+    success: true,
+    conversationId: source.conversationId ?? null,
+    threadId: source.threadId ?? null,
+    ready:
+      source.runtimeScopeReady !== false &&
+      source.historyLoad?.status !== 'loading' &&
+      source.historyLoad?.status !== 'error',
+  };
+}

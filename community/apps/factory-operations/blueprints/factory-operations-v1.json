  "routeFacts": [
    {
      "key": "execution-authority",
      "sourceArtifactKey": "recovery-plan",
      "values": ["auto-safe", "approval-required"]
    },
    {
      "key": "execution-outcome",
      "sourceArtifactKey": "execution-batch",
      "values": ["complete", "partial-failure"]
    },
    {
      "key": "approval-outcome",
      "sourceArtifactKey": "recovery-plan",
      "values": ["approved", "rejected"]
    },
    {
      "key": "recovery-outcome",
      "sourceArtifactKey": "recovery-verification",
      "values": ["recovered", "needs-intervention"]
    }
  ],
  "nodes": [
    {
      "key": "detect-anomaly",
      "title": "Detect Production Anomaly",
      "kind": "task",
      "laneKey": "event-intake",
      "stageKey": "detection",
      "openMode": "dialog",
      "accountableRoleKey": "anomaly-triage-specialist",
      "completion": {
        "artifactKey": "anomaly-event",
        "predicate": "status == open && severity in [high, critical]"
      },
      "execution": { "mode": "system", "toolNames": [] },
      "requiredFeatureKeys": ["factory-event-triage"],
      "allowedActionKeys": ["create_demo_incident"],
      "risk": "low",
      "humanGate": "none"
    },
    {
      "key": "triage-event",
      "title": "Triage Anomaly Event",
      "kind": "task",
      "laneKey": "event-intake",
      "stageKey": "triage",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "anomaly-triage-specialist",
      "completion": {
        "artifactKey": "triage-assessment",
        "predicate": "status == confirmed && evidenceCount >= 2"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_event_triage_record"]
      },
      "requiredFeatureKeys": ["factory-event-triage"],
      "allowedActionKeys": ["node-open", "node-start"],
      "risk": "medium",
      "humanGate": "none"
    },
    {
      "key": "diagnose-equipment",
      "title": "Diagnose Equipment",
      "kind": "task",
      "laneKey": "equipment-engineering",
      "stageKey": "parallel-analysis",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "equipment-diagnostics-specialist",
      "completion": {
        "artifactKey": "equipment-diagnosis",
        "predicate": "status == completed && evidenceCount >= 1"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_equipment_diagnosis_record"]
      },
      "requiredFeatureKeys": ["factory-equipment-diagnostics"],
      "allowedActionKeys": ["node-open", "node-start"],
      "risk": "medium",
      "humanGate": "review"
    },
    {
      "key": "assess-quality-impact",
      "title": "Assess Quality Impact",
      "kind": "task",
      "laneKey": "quality-management",
      "stageKey": "parallel-analysis",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "quality-risk-specialist",
      "completion": {
        "artifactKey": "quality-impact",
        "predicate": "status == completed && affectedQuantity >= 0"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_quality_impact_record"]
      },
      "requiredFeatureKeys": ["factory-quality-risk"],
      "allowedActionKeys": ["node-open", "node-start"],
      "risk": "high",
      "humanGate": "review"
    },
    {
      "key": "assess-production-impact",
      "title": "Assess Production Impact",
      "kind": "task",
      "laneKey": "production-planning",
      "stageKey": "parallel-analysis",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "production-impact-specialist",
      "completion": {
        "artifactKey": "production-impact",
        "predicate": "status == completed && impactedWorkOrderCount >= 0"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_production_impact_record"]
      },
      "requiredFeatureKeys": ["factory-production-impact"],
      "allowedActionKeys": ["node-open", "node-start"],
      "risk": "medium",
      "humanGate": "review"
    },
    {
      "key": "check-resource-readiness",
      "title": "Check Resource Readiness",
      "kind": "task",
      "laneKey": "maintenance-and-logistics",
      "stageKey": "parallel-analysis",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "resource-readiness-specialist",
      "completion": {
        "artifactKey": "resource-readiness",
        "predicate": "status == completed && spareAvailability in [available, unavailable]"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_resource_readiness_record"]
      },
      "requiredFeatureKeys": ["factory-resource-readiness"],
      "allowedActionKeys": ["node-open", "node-start"],
      "risk": "medium",
      "humanGate": "review"
    },
    {
      "key": "generate-recovery-plan",
      "title": "Generate Recovery Plan",
      "kind": "task",
      "laneKey": "recovery-planning",
      "stageKey": "recovery-planning",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "recovery-planning-specialist",
      "completion": {
        "artifactKey": "recovery-plan",
        "predicate": "status == proposed && optionCount >= 2 && recommendedOptionId != null"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_recovery_plan_generate"]
      },
      "requiredFeatureKeys": ["factory-recovery-planning"],
      "allowedActionKeys": ["node-open", "node-start"],
      "risk": "high",
      "humanGate": "review"
    },
    {
      "key": "route-execution-authority",
      "title": "Route Execution Authority",
      "kind": "router",
      "stageKey": "human-decision",
      "routeFactKey": "execution-authority"
    },
    {
      "key": "approve-recovery-plan",
      "title": "Decide Recovery Plan",
      "kind": "task",
      "laneKey": "operations-approval",
      "stageKey": "human-decision",
      "openMode": "dialog",
      "accountableRoleKey": "operations-approval-advisor",
      "completion": {
        "artifactKey": "recovery-plan",
        "predicate": "approvalStatus in [approved, rejected] && approvalRevision == revision"
      },
      "execution": { "mode": "human", "toolNames": [] },
      "requiredFeatureKeys": ["factory-operations-workbench"],
      "allowedActionKeys": [
        "node-open",
        "human-task-complete",
        "approve_recovery_plan",
        "reject_recovery_plan"
      ],
      "risk": "irreversible",
      "humanGate": "approval"
    },
    {
      "key": "route-approval-outcome",
      "title": "Route Approval Outcome",
      "kind": "router",
      "stageKey": "human-decision",
      "routeFactKey": "approval-outcome"
    },
    {
      "key": "execute-recovery-plan",
      "title": "Execute Approved Recovery Plan",
      "kind": "task",
      "laneKey": "operations-approval",
      "stageKey": "governed-execution",
      "openMode": "dialog",
      "accountableRoleKey": "operations-approval-advisor",
      "completion": {
        "artifactKey": "execution-batch",
        "predicate": "status in [completed, partial_failure] && confirmationCount == actionCount"
      },
      "execution": { "mode": "system", "toolNames": [] },
      "requiredFeatureKeys": ["factory-recovery-execution"],
      "allowedActionKeys": [
        "node-open",
        "execute_recovery_plan",
        "retry_recovery_action"
      ],
      "risk": "irreversible",
      "humanGate": "external_confirmation"
    },
    {
      "key": "route-execution-outcome",
      "title": "Route Execution Outcome",
      "kind": "router",
      "stageKey": "governed-execution",
      "routeFactKey": "execution-outcome"
    },
    {
      "key": "verify-recovery",
      "title": "Verify Production Recovery",
      "kind": "task",
      "laneKey": "recovery-validation",
      "stageKey": "verification",
      "openMode": "view",
      "workspaceKey": "factory-case-workspace",
      "accountableRoleKey": "recovery-verification-specialist",
      "completion": {
        "artifactKey": "recovery-verification",
        "predicate": "status == completed && evidenceCount >= 3"
      },
      "execution": {
        "mode": "assistant_task",
        "toolNames": ["factory_recovery_verification_record"]
      },
      "requiredFeatureKeys": ["factory-recovery-validation"],
      "allowedActionKeys": ["node-open", "node-start", "verify_recovery"],
      "risk": "high",
      "humanGate": "review"
    },
    {
      "key": "route-recovery-outcome",
      "title": "Route Recovery Outcome",
      "kind": "router",
      "stageKey": "verification",
      "routeFactKey": "recovery-outcome"
    },
    {
      "key": "production-recovered",
      "title": "Production Recovered",
      "kind": "terminal",
      "stageKey": "verification"
    },
    {
      "key": "human-intervention-required",
      "title": "Human Intervention Required",
      "kind": "terminal",
      "stageKey": "verification"
    }
  ],
  "edges": [
    { "from": "detect-anomaly", "to": "triage-event" },
    { "from": "triage-event", "to": "diagnose-equipment" },
    { "from": "triage-event", "to": "assess-quality-impact" },
    { "from": "triage-event", "to": "assess-production-impact" },
    { "from": "triage-event", "to": "check-resource-readiness" },
    { "from": "diagnose-equipment", "to": "generate-recovery-plan" },
    { "from": "assess-quality-impact", "to": "generate-recovery-plan" },
    { "from": "assess-production-impact", "to": "generate-recovery-plan" },
    { "from": "check-resource-readiness", "to": "generate-recovery-plan" },
    { "from": "generate-recovery-plan", "to": "route-execution-authority" },
    {
      "from": "route-execution-authority",
      "to": "execute-recovery-plan",
      "condition": { "factKey": "execution-authority", "value": "auto-safe" }
    },
    {

{
  "schemaVersion": "1.3",
  "pipeline": {
    "key": "factory-anomaly-recovery",
    "title": "Factory Intelligent Operations and Anomaly Recovery",
    "description": "A fixed, versioned DAG for investigating a production anomaly, reconciling specialist findings, approving a recovery plan, executing governed simulator actions, and verifying recovery.",
    "artifactNamespace": "factory_ops",
    "templateKey": "factory_anomaly_recovery",
    "templateVersion": 3,
    "startNodeKey": "detect-anomaly"
  },
  "caseModel": {
    "keyField": "case-id",
    "titleField": "case-title",
    "statusField": "case-status",
    "revisionField": "case-revision",
    "templateKeyField": "flow-template-key",
    "templateVersionField": "flow-template-version",
    "scopeFields": ["tenant-id", "organization-id"],
    "lifecycleStatuses": [
      "investigating",
      "awaiting-approval",
      "approved",
      "verifying",
      "recovered",
      "escalated",
      "rejected"
    ]
  },
  "delivery": {
    "surfaces": ["assistant", "backend", "workbench"],
    "assistantTopology": "both",
    "assistantParticipants": {
      "roleMode": "independent_assistants",
      "orchestratorDelegation": "external_xperts",
      "externalXpertConnections": "direct_required"
    },
    "pipelineWorkbench": {
      "mode": "required",
      "overviewViewKey": "factory-operations-center",
      "dashboardViewKey": "factory-operations-dashboard"
    }
  },
  "projectionContract": {
    "dashboardProject": "factory-dashboard-project",
    "caseList": "factory-case-list",
    "caseCreate": "factory-case-create",
    "caseGet": "factory-case-get",
    "flowProject": "factory-flow-project",
    "executableNodes": "factory-executable-nodes",
    "nodeStart": "factory-node-start",
    "nextNodeProcess": "factory-next-node-process",
    "humanTaskComplete": "factory-human-task-complete",
    "blockerResolve": "factory-blocker-resolve",
    "nodeWorkspaceGet": "factory-node-workspace-get",
    "executionRecordList": "factory-execution-record-list",
    "refreshStrategy": "hybrid"
  },
  "executionRecords": {
    "mode": "case_node_lane_bound",
    "retention": "immutable_attempts",
    "navigationClientCommand": "workbench.navigation.open",
    "navigationTarget": "assistant.conversation",
    "visibleLimit": 10,
    "presentationTargets": ["assistant_card", "task_card"]
  },
  "viewExperience": {
    "componentLibrary": "shadcn-ui-local-cli",
    "dashboard": {
      "chartLibrary": "echarts",
      "layout": "management_monitoring"
    },
    "swimlane": {
      "assistantAvatarSource": "platform_assistant",
      "assistantExecutionMarkerPlacement": "assistant_card_bottom_right",
      "nodeExecutionMarkerPlacement": "task_card_bottom_right",
      "logicNodeShape": "diamond",
      "dragPan": true,
      "laneSelection": true
    }
  },
  "features": [
    "factory-case-coordination",
    "factory-event-triage",
    "factory-equipment-diagnostics",
    "factory-quality-risk",
    "factory-production-impact",
    "factory-resource-readiness",
    "factory-recovery-planning",
    "factory-recovery-execution",
    "factory-recovery-validation",
    "factory-operations-workbench",
    "factory-operations-management-dashboard"
  ],
  "roles": [

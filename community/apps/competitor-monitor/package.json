{
  "name": "@community/apps-competitor-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Xpert business app for evidence-based competitor monitoring and human-reviewed advice.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "competitor_monitor"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build-remote.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:dist": "node scripts/build-remote.mjs --check"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.18.4",
    "@xpert-ai/plugin-sdk": "^3.18.4",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "22.18.6",
    "@xpert-ai/contracts": "3.18.4",
    "@xpert-ai/plugin-sdk": "3.18.4",
    "reflect-metadata": "0.2.2",
    "sql.js": "1.13.0",
    "tsx": "4.20.5",
    "typeorm": "0.3.24",
    "typescript": "5.9.2",
    "zod": "3.25.67"
  }
}

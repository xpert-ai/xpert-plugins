                    "title": {
                      "en_US": "governance",
                      "zh_Hans": "主数据治理专员"
                    }
                  },
                  {
                    "key": "publisher",
                    "templateKey": "material-identity-publisher",
                    "primaryAgentKey": "Agent_publisher",
                    "title": {
                      "en_US": "publisher",
                      "zh_Hans": "系统发布与监控专员"
                    }
                  }
                ]
              },
              "scope": "organization",
              "assistantTemplateKey": "material-identity-coordinator",
              "workspace": {
                "mode": "dedicated",
                "name": {
                  "en_US": "Material Identity Governance",
                  "zh_Hans": "物料主数据智能治理"
                },
                "description": {
                  "en_US": "Shared workspace for seven roles and their coordinator.",
                  "zh_Hans": "七位业务角色及治理协调者的组织共享工作空间。"
                },
                "sharing": "organization"
              },
              "knowledgebases": [],
              "modelRequirements": {
                "primary": true
              },
              "presentation": {
                "tagline": {
                  "en_US": "One canonical identity. Evidence for every decision.",
                  "zh_Hans": "统一物料身份，让每次治理有据可查。"
                },
                "longDescription": {
                  "en_US": "Seven specialist Assistants and a coordinator reconcile source records, drawing attributes and business impact. Review evidence and approve a specific proposal revision, then follow execution and historical rounds in Project Tasks. External enterprise systems use Mock adapters.",
                  "zh_Hans": "七位业务助理与协调者汇集来源记录、图纸属性及业务影响，人工核对证据并审批指定修订的治理方案，在项目任务中追踪执行与历史轮次。外部业务系统使用 Mock 适配器。"
                },
                "developer": "XpertAI",
                "screenshots": [
                  "./assets/brand/material-identity-governance-cover-zh-v1.png"
                ],
                "features": [
                  {
                    "key": "identity",
                    "title": {
                      "en_US": "Canonical material identity",
                      "zh_Hans": "全局物料身份"
                    },
                    "description": {
                      "en_US": "Keep legitimate plant aliases while separating incompatible specifications.",
                      "zh_Hans": "保留合法工厂别名，按关键属性区分不同规格。"
                    }
                  },
                  {
                    "key": "roles",
                    "title": {
                      "en_US": "Independent role Assistants",
                      "zh_Hans": "独立角色协作"
                    },
                    "description": {
                      "en_US": "Seven role Assistants and one coordinator with explicit capabilities.",
                      "zh_Hans": "七位业务助理与一位协调者分工完成采集、图纸核验、标准化、审计、影响评估和发布。"
                    }
                  },
                  {
                    "key": "audit",
                    "title": {
                      "en_US": "Evidence and governed execution",
                      "zh_Hans": "证据与受控执行"
                    },
                    "description": {
                      "en_US": "Inspect execution records and historical rounds in Project Tasks. Human approval is bound to a proposal revision.",
                      "zh_Hans": "在项目任务中查看执行记录与历史轮次，人工审批绑定方案修订。"
                    }
                  }
                ],
                "useCases": [
                  {
                    "en_US": "Cross-plant bearing aliases",
                    "zh_Hans": "轴承跨厂编码归一"
                  },
                  {
                    "en_US": "Battery bracket code collision",
                    "zh_Hans": "电池托架同码异物拆分"
                  },
                  {
                    "en_US": "Engineering drawing duplicate prevention",
                    "zh_Hans": "研发图纸识别与重复建码拦截"
                  }
                ],
                "dataScope": {
                  "en_US": "Data is limited to the current organization and authorized case Projects. External MDM and ERP publishing is simulated with Mock adapters.",
                  "zh_Hans": "数据限定在当前组织及用户有权访问的案例项目内；向外部 MDM、ERP 的发布使用 Mock 模拟。"
                },
                "initializationSummary": {
                  "en_US": "Create an organization workspace and install the governed Assistant suite.",
                  "zh_Hans": "创建组织工作空间，安装并发布治理助理套件。"
                },
                "initializationSteps": [
                  {
                    "en_US": "Verify the organization primary model.",
                    "zh_Hans": "检查组织主模型。"
                  },
                  {
                    "en_US": "Create a shared workspace and install seven role Assistants.",
                    "zh_Hans": "创建共享工作空间并安装七位业务助理。"
                  },
                  {
                    "en_US": "Connect the role Assistants and publish the coordinator.",
                    "zh_Hans": "关联业务助理并发布治理协调者。"
                  }
                ]
              },
              "entry": {
                "type": "assistant-chat"
              }
            }
          }
        ]
      }

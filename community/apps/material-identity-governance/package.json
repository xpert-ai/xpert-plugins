{
  "name": "@xpert-ai/plugin-material-identity-governance",
  "version": "0.1.0",
  "description": "汽车零部件物料身份和主数据治理 Agentic App",
  "author": "XpertAI",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins",
    "directory": "community/apps/material-identity-governance"
  },
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    ".xpertai-plugin",
    "dist",
    "blueprints",
    "docs",
    "README.md",
    "assets"
  ],
  "scripts": {
    "generate:remote": "node scripts/build-remote.mjs",
    "build": "pnpm generate:remote && tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs && pnpm verify:dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.remote.json --noEmit",
    "test": "vitest run",
    "test:studio": "node --test scripts/studio-layout.e2e.mjs",
    "verify:dist": "node scripts/build-remote.mjs --check && node scripts/copy-assets.mjs --check",
    "verify:blueprint": "node scripts/validate-blueprint.mjs",
    "prepack": "pnpm build",
    "test:profile": "node --test scripts/profile-card.e2e.mjs"
  },
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "material_identity"
    }
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.18.2",
    "@xpert-ai/plugin-sdk": "^3.18.3",
    "react": ">=18",
    "react-dom": ">=18",
    "typeorm": "^0.3.28",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.18.2",
    "@xpert-ai/plugin-sdk": "3.18.3",
    "esbuild": "^0.27.0",
    "pg": "^8.16.3",
    "pg-mem": "^3.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.2.2",
    "short-unique-id": "4.4.4",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "3.25.67",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "echarts": "5.6.0",
    "yaml": "2.9.0",
    "lucide-react": "1.24.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3"
  }
}

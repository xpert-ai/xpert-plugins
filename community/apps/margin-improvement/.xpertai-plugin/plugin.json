                  "en_US": "Business Improvement Project",
                  "zh_Hans": "经营改善项目"
                },
                "icon": {
                  "type": "emoji",
                  "value": "📈",
                  "background": "#E0F2EE"
                },
                "binding": {
                  "kind": "project"
                }
              }
            ],
            "appConfig": {
              "scope": "organization",

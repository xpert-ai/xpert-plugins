                    "title": {
                      "en_US": "procurement",
                      "zh_Hans": "采购核实 Assistant"
                    }
                  },
                  {
                    "key": "execution",
                    "templateKey": "margin-improvement-execution",
                    "primaryAgentKey": "Agent_execution",
                    "title": {
                      "en_US": "execution",
                      "zh_Hans": "受控执行 Assistant"
                    }
                  }
                ]
              },
              "workspace": {
                "mode": "dedicated",
                "name": {
                  "en_US": "Margin Improvement",
                  "zh_Hans": "经营偏差闭环"
                },
                "description": {
                  "en_US": "Governed manufacturing demonstration",
                  "zh_Hans": "制造业经营闭环演示"
                },
                "sharing": "organization"
              },
              "knowledgebases": [],
              "modelRequirements": {
                "primary": true
              },
              "presentation": {
                "tagline": {
                  "en_US": "Understand the variance. Drive improvement.",
                  "zh_Hans": "看清偏差，推动改善。"
                },
                "longDescription": {
                  "en_US": "Use an authorized Data Xpert ontology to investigate margin variance, verify procurement evidence, propose an action, obtain human approval and review the result. Four independent Assistants work in a native Project Pipeline; Finance can author a Live Dashboard.",
                  "zh_Hans": "基于已授权的 Data Xpert 本体发现经营偏差、核实采购事实、形成方案，经人工批准后记录执行回执，再按同一口径复查。四个独立 Assistant 在原生项目流水线中分工，财务 Assistant 可制作 Live Dashboard。"
                },
                "developer": "XpertAI",
                "screenshots": [
                  "./assets/brand/margin-improvement-cover-zh-v1.png"
                ],
                "features": [
                  {
                    "key": "ontology-analysis",
                    "title": {
                      "en_US": "Ontology-backed analysis",
                      "zh_Hans": "本体分析"
                    },
                    "description": {
                      "en_US": "Query published Data Xpert models through explicit bindings and retain source evidence.",
                      "zh_Hans": "通过明确配置的查询绑定读取已发布本体模型，保留指标口径与来源证据。"
                    }
                  },
                  {
                    "key": "project-pipeline",
                    "title": {
                      "en_US": "Four-role collaboration",
                      "zh_Hans": "四个角色协作"
                    },
                    "description": {
                      "en_US": "Coordinate finance, procurement and execution Assistants in a Project; route variance to action or monitoring.",
                      "zh_Hans": "协调、财务、采购与执行 Assistant 分工，Router 根据偏差阈值选择处置或持续观察。"
                    }
                  },
                  {
                    "key": "human-decisions",
                    "title": {
                      "en_US": "Human approval and acceptance",
                      "zh_Hans": "人工批准与验收"
                    },
                    "description": {
                      "en_US": "People approve the exact proposal version and accept review results. Execution creates a local demo receipt only.",
                      "zh_Hans": "业务负责人批准准确版本的方案并验收复查结果；当前执行节点仅生成本地演示回执。"
                    }
                  },
                  {
                    "key": "live-dashboard",
                    "title": {
                      "en_US": "Live Dashboard",
                      "zh_Hans": "持续查看经营变化"
                    },
                    "description": {
                      "en_US": "Finance can create and refresh a Live Dashboard using authorized ontology queries.",
                      "zh_Hans": "财务 Assistant 可基于已授权本体查询创建并刷新 Live Dashboard，持续查看经营变化。"
                    }
                  }
                ],
                "useCases": [
                  {
                    "en_US": "Manufacturing margin variance investigation",
                    "zh_Hans": "制造业毛利偏差分析"
                  },
                  {
                    "en_US": "Procurement cost evidence review",
                    "zh_Hans": "采购成本事实核对"
                  },
                  {
                    "en_US": "Approved action and next-period review",
                    "zh_Hans": "获批处置与下一期复查"
                  }
                ],
                "dataScope": {
                  "en_US": "Access follows organization, workspace and Project permissions. Data Xpert resources and read actions require explicit authorization. Bundled data is synthetic; local receipts do not write to SAP or establish business impact.",
                  "zh_Hans": "访问遵循组织、工作空间及项目权限；Data Xpert 资源与只读动作需明确授权。内置数据为合成样本，本地回执不代表 SAP 写回或真实业务成效。"
                },
                "initializationSummary": {
                  "en_US": "Prepare a dedicated workspace and publish the coordinator and three specialist Assistants. Before running a Project, configure ontology query bindings, authorize resources and bind the published roles as Project members.",
                  "zh_Hans": "准备专用工作空间并发布协调者与三个专业 Assistant。运行项目前，需配置本体查询绑定、授权资源，并将已发布角色绑定为项目成员。"
                },
                "initializationSteps": [
                  {
                    "en_US": "Check an available primary model.",
                    "zh_Hans": "检查可用主模型。"
                  },
                  {
                    "en_US": "Create the dedicated application workspace.",
                    "zh_Hans": "创建应用专用工作空间。"
                  },
                  {
                    "en_US": "Install and publish four Assistant roles.",
                    "zh_Hans": "安装并发布四个 Assistant 角色。"
                  }
                ]
              },
              "entry": {
                "type": "assistant-chat"
              }
            }
          }
        ]

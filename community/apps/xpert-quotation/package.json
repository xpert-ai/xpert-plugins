{
  "name": "@xpert-ai/plugin-xpert-quotation",
  "version": "1.1.0",
  "description": "Xpert quotation Workbench with structured quota ingestion, resource-level knowledge pricing, deterministic comprehensive-rate calculation, review evidence, and format-preserving XLSX patching.",
  "author": {
    "name": "XpertAI",
    "url": "https://xpertai.cn"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/xpert-quotation"
  },
  "bugs": {
    "url": "https://github.com/xpert-ai/xpert-plugins/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "scripts/quota-normalizer.mjs", ".xpertai-plugin", "assets", "README.md", "!**/*.tsbuildinfo"],
  "scripts": {
    "build:ui": "pnpm --filter @xpert-ai/plugin-shadcn-ui build",
    "build": "pnpm run build:ui && node scripts/build-remote-components.mjs && tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs",
    "knowledge:normalize": "node scripts/normalize-quota-pdf.mjs",
    "test:quota-normalizer": "node --test scripts/quota-normalizer.test.mjs",
    "test": "pnpm run test:quota-normalizer && pnpm run build:ui && jest --config jest.config.mjs --runInBand && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.remote.json --noEmit && node scripts/build-remote-components.mjs --check",
    "typecheck": "pnpm run build:ui && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.remote.json --noEmit && node scripts/build-remote-components.mjs --check",
    "prepack": "pnpm run build:ui && npm run build"
  },
  "xpert": { "plugin": { "level": "system", "artifactNamespace": "xpert_quotation" } },
  "dependencies": {
    "@univerjs/core": "0.25.0",
    "@univerjs/design": "0.25.0",
    "@univerjs/docs": "0.25.0",
    "@univerjs/docs-ui": "0.25.0",
    "@univerjs/engine-formula": "0.25.0",
    "@univerjs/engine-render": "0.25.0",
    "@univerjs/sheets": "0.25.0",
    "@univerjs/sheets-formula": "0.25.0",
    "@univerjs/sheets-formula-ui": "0.25.0",
    "@univerjs/sheets-numfmt": "0.25.0",
    "@univerjs/sheets-numfmt-ui": "0.25.0",
    "@univerjs/sheets-ui": "0.25.0",
    "@univerjs/ui": "0.25.0",
    "fast-xml-parser": "^5.3.7",
    "jszip": "^3.10.1",
    "lucide-react": "1.24.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "@xpert-ai/contracts": "^3.15.7",
    "@xpert-ai/plugin-sdk": "^3.15.6",
    "react": ">=18",
    "react-dom": ">=18",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@swc/core": "~1.5.7",
    "@swc/jest": "~0.2.38",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.15.7",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "@xpert-ai/plugin-sdk": "3.15.6",
    "esbuild": "^0.27.0",
    "jest": "^29.7.0",
    "pdfjs-dist": "5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.1.18",
    "typeorm": "^0.3.24",
    "typescript": "^5.9.2",
    "yaml": "^2.6.1",
    "zod": "3.25.67"
  },
  "publishConfig": { "access": "public" }
}

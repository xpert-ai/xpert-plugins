# GEO Intelligence Workspace - Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# DeepSeek API Configuration
# Required for LLM calls in the Python GEO service
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Custom model name (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Optional: Custom API endpoint (default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# GEO Service Security
# Required: Token for authenticating API requests between Xpert plugin and GEO service
# Generate a random secure token and use the same value in both places
GEO_INTERNAL_TOKEN=your_secure_random_token_here

# GEO Service Connection (for Xpert plugin)
# Optional: URL where the GEO Python service is running
# Default: http://host.docker.internal:8765
# For Docker deployments, ensure this URL is reachable from the Xpert container
GEO_ENGINE_URL=http://host.docker.internal:8765

# Database Configuration
# Optional: SQLite database file path
# Default: data/geo.sqlite3
# Use ":memory:" for temporary in-memory database (testing only)
GEO_DB_PATH=data/geo.sqlite3

# Development Mode
# Optional: Set to "true" to seed demo data on startup
GEO_DEMO_MODE=false

  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "artifactNamespace": "customer_demand",
  "xpert": {
    "plugin": {
      "level": "system"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "node --import tsx scripts/preview.ts",
    "preview:fixture": "node ../../../tools/remote-view-preview/cli.mjs --config ./preview.config.mjs --port 4417",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test:live": "node --import tsx scripts/live-check.ts"
  },

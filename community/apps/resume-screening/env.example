# Store connection settings in ignored community/.env if desired.
# Official deploy CLI does not auto-load that file: inject into its process.
# This plugin registers server entities and requires system-level installation.
XPERT_API_URL=http://localhost:3000/
# Inject login credentials through your approved secret manager/current process.
XPERT_USERNAME=
XPERT_PASSWORD=
# Alternatively inject a temporary administrator login JWT; never a model key.
XPERT_TOKEN=
XPERT_TENANT_ID=
# system-level plugin: Default tenant scope; no organization ID.
XPERT_SCOPE=tenant
XPERT_PLUGIN_NAME=@xpert-ai/plugin-resume-screening
XPERT_PLUGIN_WORKSPACE_PATH=./apps/resume-screening
XPERT_PLUGIN_CONFIG_JSON={}

diff --git a/apps/cloud/src/app/auth/auth.providers.ts b/apps/cloud/src/app/auth/auth.providers.ts
new file mode 100644
--- /dev/null
+++ b/apps/cloud/src/app/auth/auth.providers.ts
@@ -0,0 +1,31 @@
+import { Injector, Provider } from '@angular/core'
+import {
+  defaultAuthOptions,
+  XpAuthOptions,
+  XP_AUTH_OPTIONS,
+  XP_AUTH_STRATEGIES,
+  XP_AUTH_USER_OPTIONS
+} from './auth.options'
+import { deepExtend } from './helpers'
+import { XpAuthStrategy } from './strategies/auth-strategy'
+
+export function nbOptionsFactory(options?: XpAuthOptions): XpAuthOptions {
+  return deepExtend(defaultAuthOptions, options)
+}
+
+export function nbStrategiesFactory(options: XpAuthOptions, injector: Injector): XpAuthStrategy[] {
+  return (options.strategies ?? []).map(([strategyClass, strategyOptions]) => {
+    const strategy = injector.get(strategyClass)
+    strategy.setOptions(strategyOptions)
+    return strategy
+  })
+}
+
+// Core needs the providers without eagerly loading the routed authentication UI.
+export function provideXpAuthOptions(options?: XpAuthOptions): Provider[] {
+  return [
+    { provide: XP_AUTH_USER_OPTIONS, useValue: options },
+    { provide: XP_AUTH_OPTIONS, useFactory: nbOptionsFactory, deps: [XP_AUTH_USER_OPTIONS] },
+    { provide: XP_AUTH_STRATEGIES, useFactory: nbStrategiesFactory, deps: [XP_AUTH_OPTIONS, Injector] }
+  ]
+}
diff --git a/packages/server/src/plugin/installation/npm-command.ts b/packages/server/src/plugin/installation/npm-command.ts
new file mode 100644
--- /dev/null
+++ b/packages/server/src/plugin/installation/npm-command.ts
@@ -0,0 +1,15 @@
+// Windows npm shims are scripts, not native executables. Run the CLI with Node
+// so child_process can pass arguments directly without a command shell.
+import { win32 } from 'node:path'
+
+export function resolveNpmCommand(
+	args: readonly string[],
+	runtime: { platform: NodeJS.Platform; executablePath: string } = {
+		platform: process.platform,
+		executablePath: process.execPath
+	}
+): { command: string; args: string[] } {
+	if (runtime.platform !== 'win32') return { command: 'npm', args: [...args] }
+	const cli = win32.join(win32.dirname(runtime.executablePath), 'node_modules', 'npm', 'bin', 'npm-cli.js')
+	return { command: runtime.executablePath, args: [cli, ...args] }
+}

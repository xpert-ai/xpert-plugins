+/** Windows cannot spawn corepack.cmd directly; run the installed JS entry with Node. */
+export function resolveLocalPluginCommand(plan, options = {}) {
+  const platform = options.platform ?? process.platform
+  const nodePath = options.nodePath ?? process.execPath
+  const pathValue = options.pathValue ?? process.env.PATH ?? process.env.Path ?? ''
+  const exists = options.exists ?? fs.existsSync
+  if (platform !== 'win32' || plan.shell || plan.command !== 'corepack') return plan
+  const roots = [path.win32.dirname(nodePath), ...pathValue.split(';').filter(Boolean).map((value) => value.replace(/^"|"$/g, ''))]
+  const entry = roots.map((root) => path.win32.join(root, 'node_modules', 'corepack', 'dist', 'corepack.js')).find(exists)
+  if (!entry) throw new LocalPluginCliError('Cannot locate the installed Corepack JS entry. Add the Node installation directory to PATH.')
+  return { ...plan, command: nodePath, args: [entry, ...(plan.args ?? [])], shell: false }
+}

{
  "name": "@xpert-ai/plugin-support-ticket-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Human-reviewed customer support ticket triage for Xpert Workbench",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "tickets", "README.md", "docs"],
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/support-ticket-triage"
  },
  "xpert": {
    "plugin": { "level": "system", "artifactNamespace": "support_ticket_triage" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.remote.json && node scripts/build-remote.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "verify:dist": "node scripts/build-remote.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "zod": "3.25.67"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.38.1",
    "@xpert-ai/plugin-sdk": "^3.38.1",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.38.1",
    "@xpert-ai/plugin-sdk": "3.38.1",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "axios": "1.12.2",
    "esbuild": "0.28.1",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "short-unique-id": "5.3.2",
    "typeorm": "^0.3.24",
    "typescript": "^5.9.2"
  }
}

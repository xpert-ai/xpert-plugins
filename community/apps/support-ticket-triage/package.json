  "license": "AGPL-3.0",
  "repository": { "type": "git", "url": "https://github.com/xpert-ai/xpert-plugins.git", "directory": "community/apps/support-ticket-triage" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { "./package.json": "./package.json", ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" } },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "build:remote": "node scripts/build-remote.mjs",
    "build": "npm run build:remote && tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs",
    "test": "node --experimental-strip-types --test src/domain/ticket-state.test.ts src/domain/analysis-parser.test.ts",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "xpert": { "plugin": { "level": "system", "artifactNamespace": "support_ticket_triage" } },
  "dependencies": { "tslib": "^2.8.1" },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0", "@nestjs/common": "^11.1.6", "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.15.4", "@xpert-ai/plugin-sdk": "^3.15.4",
    "react": ">=18", "react-dom": ">=18", "typeorm": "^0.3.24", "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72", "@nestjs/common": "11.1.6", "@nestjs/core": "11.1.6", "@nestjs/typeorm": "11.0.0",
    "@types/node": "^20.19.9", "@types/react": "^18.3.12", "@types/react-dom": "^18.3.1",
    "@xpert-ai/contracts": "3.15.4", "@xpert-ai/plugin-sdk": "3.15.4", "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.25.0", "react": "^18.3.1", "react-dom": "^18.3.1", "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24", "typescript": "^5.9.2", "zod": "3.25.67"
  },
  "publishConfig": { "access": "public" }
}

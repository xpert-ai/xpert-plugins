{
  "name": "@community/apps-support-ticket-triage",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0",
  "description": "Review AI triage suggestions for customer support tickets in Xpert.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "examples"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "vitest run"
  },
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "support_triage"
    }
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.72",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.38.0",
    "@xpert-ai/plugin-sdk": "^3.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typeorm": "^0.3.28",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.38.0",
    "@xpert-ai/plugin-sdk": "3.38.0",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.13.0",
    "typeorm": "0.3.28",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "3.25.67"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}

# Copy to .env.acceptance for your isolated test platform. Keep the copy private.
MANUFACTURING_ACCEPTANCE_ISOLATED=0
XPERT_API_URL=http://127.0.0.1:3000
XPERT_WEB_URL=http://localhost:4200
XPERT_TENANT_ID=
XPERT_ORG_ID=
XPERT_ORG_NAME=
MANUFACTURING_ASSISTANT_ID=
# Required by model-failure.mjs for its temporary Assistant.
XPERT_WORKSPACE_ID=
XPERT_TEST_ADMIN_EMAIL=
# Leave blank in the file. Supply the password through the process environment.
XPERT_TEST_ADMIN_PASSWORD=
# Optional absolute path to the playwright-core package directory.
MANUFACTURING_PLAYWRIGHT_MODULE=
MANUFACTURING_BROWSER_CHANNEL=chrome
MANUFACTURING_BROWSER_PATH=

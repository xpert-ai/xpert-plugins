{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@xpert-ai/plugin-shadcn-ui": ["../../../packages/shadcn-ui/src/index.ts"],
      "@xpert-ai/plugin-shadcn-ui/theme": ["../../../packages/shadcn-ui/src/theme.ts"],
      "@xpert-ai/plugin-shadcn-ui/style.css": ["../../../packages/shadcn-ui/src/style.css"]
    }
  },
  "include": ["src/lib/remote-components/resume-match/src/**/*.ts", "src/lib/remote-components/resume-match/src/**/*.tsx", "src/lib/remote-components/resume-match/src/shims/**/*.ts"]
}

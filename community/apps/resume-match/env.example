# Connection settings for the host deployment CLI, not model credentials.
# Store real deployment credentials in the host-supported secret store.
XPERT_API_URL=http://localhost:3000

# Optional explicit tenant override. Otherwise the authenticated tenant is used.
XPERT_TENANT_ID=

# Configure the model provider and its API key inside Xpert.
# This plugin does not call the model provider directly or require its own API key.

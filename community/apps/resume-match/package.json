{
  "name": "@xpert-ai/plugin-resume-match",
  "version": "0.1.0",
  "private": true,
  "description": "简历智能分析与岗位匹配系统：把岗位说明与简历转化为可解释、可复核、可追溯的匹配结论。",
  "author": {
    "name": "谢祥伦",
    "url": "https://github.com/minxiangxuan962-source"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/resume-match"
  },
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "files": [
    ".xpertai-plugin",
    "dist",
    "index.cjs",
    "assets",
    "docs",
    "env.example",
    "README.md"
  ],
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "resume_match"
    }
  },
  "scripts": {
    "generate:remote": "node scripts/build-remote.mjs",
    "build": "corepack pnpm generate:remote && tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs && corepack pnpm verify:dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.remote.json --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration-test.mjs",
    "verify:dist": "node scripts/build-remote.mjs --check && node scripts/copy-assets.mjs --check",
    "preview": "node scripts/preview-server.mjs",
    "prepack": "corepack pnpm build"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.30.2",
    "@xpert-ai/plugin-sdk": "^3.30.2",
    "react": ">=18",
    "react-dom": ">=18",
    "typeorm": "^0.3.28",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/contracts": "3.30.2",
    "@xpert-ai/plugin-sdk": "3.30.2",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.3",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "3.25.67"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

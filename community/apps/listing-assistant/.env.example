# Local development only. Never commit real credentials.
#
# The plugin itself reads no environment variables: model credentials live in
# the Xpert platform's model-provider configuration. These values are only used
# by the host-side deploy CLI (`plugin:deploy:local`).

XPERT_API_URL=http://localhost:3000
XPERT_USERNAME=admin@example.com
XPERT_PASSWORD=replace-with-local-test-password
XPERT_SCOPE=tenant
XPERT_TENANT_ID=00000000-0000-0000-0000-000000000000
# XPERT_ORG_ID=00000000-0000-0000-0000-000000000000

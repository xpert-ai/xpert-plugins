{
  "name": "@xpert-ai/plugin-lease-admission-review",
  "version": "0.2.1",
  "description": "Evidence extraction and human confirmation for a small admission review workflow",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "scripts/upgrade-scoring.cjs",
    "README.md"
  ],
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "lease_admission_review"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-remote.mjs && node scripts/assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json --noEmit",
    "test": "node --test test/*.test.cjs",
    "verify:dist": "node scripts/build-remote.mjs --check && node scripts/assets.mjs --check"
  },
  "peerDependencies": {
    "@xpert-ai/plugin-sdk": "^3.18.7",
    "@xpert-ai/contracts": "^3.18.6",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@langchain/core": "^0.3.72",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@xpert-ai/plugin-sdk": "3.18.7",
    "@xpert-ai/contracts": "3.18.6",
    "@nestjs/common": "11.1.13",
    "@nestjs/core": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@langchain/core": "0.3.72",
    "typeorm": "0.3.28",
    "zod": "3.25.67",
    "typescript": "~5.9.2",
    "@types/node": "^22.17.0",
    "reflect-metadata": "^0.2.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "lucide-react": "1.24.0",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.27.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3",
    "i18next": "^25.0.0",
    "pg": "^8.16.3"
  }
}

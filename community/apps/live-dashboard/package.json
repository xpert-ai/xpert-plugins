{
  "name": "@xpert-ai/plugin-live-dashboard",
  "version": "0.1.0",
  "description": "Versioned live dashboards using platform analytics and Data Analytics renderer",
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.cjs",
    "README.md",
    "docs",
    "examples",
    ".xpertai-plugin",
    "skills"
  ],
  "scripts": {
    "verify:dist": "node scripts/verify-dist.mjs && node scripts/build-action.mjs --verify && node scripts/build-libraries.mjs --verify",
    "build": "node scripts/build-libraries.mjs && tsc -p tsconfig.json && tsc -p tsconfig.remote.json --noEmit && node scripts/build-remote.mjs && node scripts/build-action.mjs",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "AGPL-3.0",
  "private": true,
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "live_dashboard"
    }
  },
  "peerDependencies": {
    "@xpert-ai/plugin-sdk": "^3.21.0",
    "@xpert-ai/contracts": "^3.21.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67",
    "@langchain/core": ">=0.3.0"
  },
  "devDependencies": {
    "echarts": "5.6.0",
    "three": "0.185.1",
    "@xpert-ai/plugin-sdk": "^3.21.0",
    "@xpert-ai/contracts": "^3.21.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67",
    "typescript": "^5.9.2",
    "@types/node": "^20.19.9",
    "reflect-metadata": "^0.2.2",
    "@langchain/core": "0.3.72",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "vite": "^7.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "@xpert-ai/community-data-analytics": "workspace:^"
  }
}

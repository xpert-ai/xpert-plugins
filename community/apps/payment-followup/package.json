{
  "name": "@community/apps-payment-followup",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed payment promise review and human-confirmed follow-up in Xpert.",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@8.15.8",
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/payment-followup"
  },
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "payment_followup"
    }
  },
  "files": [
    "dist",
    "index.cjs",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build:ui": "pnpm --filter @xpert-ai/plugin-shadcn-ui build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "build": "pnpm run build:ui && pnpm run typecheck && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:dist": "node scripts/build.mjs --check",
    "test:ui": "node scripts/test-ui.mjs",
    "test:platform-failure": "node scripts/test-platform-failure.mjs"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/typeorm": "11.0.0",
    "@xpert-ai/contracts": "^3.29.0",
    "@xpert-ai/plugin-sdk": "^3.29.0",
    "typeorm": "0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/typeorm": "11.0.0",
    "@xpert-ai/contracts": "^3.29.0",
    "@xpert-ai/plugin-sdk": "^3.29.0",
    "typeorm": "0.3.24",
    "zod": "3.25.67",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "typescript": "5.9.2",
    "pg": "8.16.3",
    "yaml": "2.8.1",
    "@nestjs/cqrs": "11.0.3",
    "playwright": "1.62.1"
  }
}

{
  "name": "@xpert-ai/plugin-candidate-intake",
  "version": "0.1.0",
  "description": "Candidate self-service intake, resume prefill, Agent screening, and HR review for Xpert.",
  "author": {
    "name": "XpertAI Community"
  },
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "remote:typecheck": "tsc -p tsconfig.remote.json --noEmit",
    "build": "pnpm run remote:typecheck && node scripts/build-remote-components.mjs && tsc -p tsconfig.lib.json && node scripts/copy-assets.mjs",
    "test": "node scripts/smoke-test.mjs && tsc -p tsconfig.spec.json --noEmit && pnpm run remote:typecheck",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "candidate_intake"
    }
  },
  "dependencies": {
    "axios": "1.13.2",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "short-unique-id": "5.3.2",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.10.1",
    "@xpert-ai/plugin-sdk": "^3.10.1",
    "express": ">=4",
    "react": ">=18",
    "react-dom": ">=18",
    "typeorm": "^0.3.24",
    "yaml": ">=2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.19.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@xpert-ai/contracts": "^3.10.1",
    "@xpert-ai/plugin-sdk": "^3.10.1",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.25.9",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.24",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1",
    "zod": "3.25.67"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@xpert-ai/plugin-aftersales-ticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "售后工单处理工作台",
  "license": "AGPL-3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "corepack pnpm --filter @xpert-ai/plugin-shadcn-ui build && tsc -p tsconfig.json && node scripts/build-remote.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --experimental-strip-types --test test/*.test.mjs"
  },
  "xpert": {
    "plugin": {
      "level": "tenant",
      "artifactNamespace": "aftersales_ticket"
    }
  },
  "dependencies": {
    "@nestjs/common": "11.1.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.67",
    "@langchain/core": "0.3.72",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.38.1",
    "@xpert-ai/plugin-sdk": "^3.38.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/core": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "22.17.0",
    "@xpert-ai/contracts": "3.38.1",
    "@xpert-ai/plugin-sdk": "3.38.1",
    "typeorm": "0.3.28",
    "typescript": "5.9.2",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "0.28.1",
    "jsdom": "26.1.0"
  }
}

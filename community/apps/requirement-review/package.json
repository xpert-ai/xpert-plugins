{
  "name": "@community/apps-requirement-review",
  "version": "0.1.0",
  "description": "ReqTrace requirement review workbench",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "smoke:installed": "node scripts/installed-platform-smoke.mjs",
    "verify:dist": "node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "tsc -p tsconfig.json && node scripts/build.mjs && node --test tests/*.test.mjs"
  },
  "license": "AGPL-3.0",
  "packageManager": "pnpm@8.15.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "community/apps/requirement-review"
  },
  "xpert": {
    "plugin": { "level": "system", "artifactNamespace": "reqtrace" }
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.72",
    "@xpert-ai/contracts": "^3.18.5",
    "@xpert-ai/plugin-sdk": "^3.18.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@xpert-ai/contracts": "3.18.5",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "@tailwindcss/cli": "4.3.2",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.2",
    "@xpert-ai/plugin-sdk": "3.18.5",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/typeorm": "11.0.0",
    "@types/node": "22.18.6",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.24",
    "typescript": "5.9.3",
    "zod": "3.25.67"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

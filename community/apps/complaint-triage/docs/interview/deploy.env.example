# Used only by the platform's `plugin:deploy:local` CLI to log in and install the plugin.
# Supply real values in the current shell (or your secret manager); never commit a filled-in copy.
# The model API key is NOT configured here: add it in Xpert under Settings -> AI model providers.
XPERT_API_URL=http://localhost:3000
XPERT_USERNAME=<test-account-email>
XPERT_PASSWORD=<test-account-password>

{
  "name": "@xpert-ai/plugin-markitdown",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "middlewares/markitdown/src",
  "projectType": "library",
  "targets": {
    "build-code": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "middlewares/markitdown/dist",
        "main": "middlewares/markitdown/src/index.ts",
        "rootDir": "middlewares/markitdown/src",
        "tsConfig": "middlewares/markitdown/tsconfig.lib.json",
        "generatePackageJson": false,
        "assets": [
          {
            "glob": "**/*.md",
            "input": "middlewares/markitdown/src",
            "output": "./"
          },
          {
            "glob": "**/*.json",
            "input": "middlewares/markitdown/src",
            "output": "./"
          }
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-code"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "node middlewares/markitdown/scripts/build-sandbox-action.mjs",
        "cwd": "."
      }
    }
  },
  "tags": []
}

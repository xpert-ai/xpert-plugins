{
  "name": "@xpert-ai/plugin-sap-bw",
  "version": "0.0.1",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins"
  },
  "bugs": {
    "url": "https://github.com/xpert-ai/xpert-plugins/issues"
  },
  "xpert": {
    "plugin": {
      "level": "organization"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.lib.json && esbuild dist/index.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/bundle.js --external:@nestjs/common --external:@xpert-ai/plugin-sdk --external:@xmldom/xmldom --external:axios --external:zod && pnpm run verify:dist",
    "verify:dist": "node scripts/verify-dist.mjs",
    "prepack": "pnpm run build"
  },
  "main": "./dist/bundle.js",
  "module": "./dist/bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js",
      "default": "./dist/bundle.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "axios": "^1.12.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@xpert-ai/plugin-xmla": "workspace:*",
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/plugin-xmla": "0.0.1",
    "@xpert-ai/plugin-sdk": "^3.15.15",
    "zod": "3.25.67"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}

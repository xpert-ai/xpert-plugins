{
  "name": "@xpert-ai/plugin-analytics-mysql",
  "version": "0.1.1",
  "description": "MySQL and Apache Doris analytics query providers",
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.cjs",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "pnpm run build && node --test tests/database.integration.cjs"
  },
  "license": "AGPL-3.0",
  "private": false,
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "analytics_mysql"
    }
  },
  "peerDependencies": {
    "@xpert-ai/plugin-sdk": "^3.26.1",
    "@xpert-ai/contracts": "^3.26.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@xpert-ai/plugin-sdk": "3.25.0",
    "@xpert-ai/contracts": "3.25.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67",
    "typescript": "^5.9.2",
    "@types/node": "^20.19.9",
    "reflect-metadata": "^0.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "xpertai/tools/analytics-mysql"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@xpert-ai/plugin-analytics-files",
  "version": "0.1.1",
  "description": "Declarative CSV, JSON and XLSX analytics over authorized Workspace files",
  "main": "./index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.cjs",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "corepack pnpm run build && node --test tests/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "AGPL-3.0",
  "private": false,
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "analytics_files"
    }
  },
  "peerDependencies": {
    "@xpert-ai/plugin-sdk": "^3.26.1",
    "@xpert-ai/contracts": "^3.26.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@xpert-ai/plugin-sdk": "3.25.0",
    "@xpert-ai/contracts": "3.25.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "zod": "3.25.67",
    "typescript": "^5.9.2",
    "@types/node": "^20.19.9",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "zod-to-json-schema": "3.25.2",
    "csv-parse": "6.1.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "decimal.js": "10.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "xpertai/tools/analytics-files"
  },
  "publishConfig": {
    "access": "public"
  }
}

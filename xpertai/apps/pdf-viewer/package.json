{
  "name": "@xpert-ai/plugin-pdf-viewer",
  "version": "0.2.0",
  "description": "Read-only native PDF preview for project files and collaboration spaces.",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".xpertai-plugin",
    "README.md",
    "docs",
    "LICENSE.chatkit-icons",
    "!**/*.tsbuildinfo"
  ],
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "pdf_viewer"
    }
  },
  "nx": {
    "name": "pdf-viewer",
    "targets": {
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "scripts": {
    "build:ui": "pnpm --filter @xpert-ai/plugin-shadcn-ui build",
    "build": "pnpm run build:ui && tsc -p tsconfig.lib.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm run build && pnpm run verify:dist && pnpm run verify:package-output",
    "verify:dist": "node scripts/build.mjs --check",
    "verify:package-output": "node scripts/verify-package-output.mjs"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "zod": "3.25.67"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@xpert-ai/contracts": "^3.36.0",
    "@xpert-ai/plugin-sdk": "^3.36.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@swc/core": "~1.5.7",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^20.19.9",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@xpert-ai/contracts": "3.36.0",
    "@xpert-ai/plugin-sdk": "3.36.0",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "^0.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.0",
    "pdfjs-dist": "6.5.438"
  }
}

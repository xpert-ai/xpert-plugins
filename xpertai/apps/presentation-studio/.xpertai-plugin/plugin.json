          {
            "type": "app",
            "name": "presentation-studio",
            "displayName": "Presentation Studio",
            "description": "Agent-ready presentation studio",
            "appConfig": {
              "scope": "organization",
              "assistantTemplateKey": "presentation-studio-assistant",
              "workspace": {
                "mode": "dedicated",
                "name": {

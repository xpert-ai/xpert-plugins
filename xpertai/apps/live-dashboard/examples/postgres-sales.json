{
  "schema": "xpert.live-dashboard/v1",
  "id": "11111111-1111-4111-8111-111111111111",
  "title": "区域销售",
  "controls": [
    {
      "controlId": "region",
      "label": "区域",
      "type": "string",
      "defaultValue": "all",

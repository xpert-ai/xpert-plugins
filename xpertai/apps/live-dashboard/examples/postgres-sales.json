      "operation": "query",
      "contractVersion": 1,
      "payload": {
        "sql": "SELECT region, amount::double precision AS amount FROM (SELECT 'east' AS region,120 AS amount UNION ALL SELECT 'west',80) AS sales WHERE $1 = 'all' OR region = $1 ORDER BY region",

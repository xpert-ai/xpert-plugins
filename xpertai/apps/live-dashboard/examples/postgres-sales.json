          "region"
        ]
      },
      "parameters": [
        {
          "name": "region",
          "controlId": "region",
          "type": "string",
          "required": true,
          "defaultValue": "all",
          "allowedValues": [
            "all",
            "east",
            "west"
          ]
        }
      ],
      "output": {
        "datasetId": "sales",
        "grain": [
          "region"
        ],
        "fields": [
          {
            "id": "region",
            "sourceField": "region",
            "label": "区域",
            "logicalType": "string",
            "role": "dimension",
            "nullable": false
          },
          {
            "id": "amount",
            "sourceField": "amount",
            "label": "销售额",
            "logicalType": "float64",
            "role": "measure",
            "nullable": false
          }
        ]
      }
    }
  ],
  "charts": [

{
  "name": "@xpert-ai/plugin-markdown-editor",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "corepack pnpm run build:ui && node scripts/build.mjs && tsc -p tsconfig.json && node scripts/build.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "tsx --test tests/*.test.ts",
    "verify:dist": "node scripts/build.mjs --check",
    "prepack": "npm run verify:dist",
    "build:ui": "corepack pnpm --filter @xpert-ai/plugin-shadcn-ui build"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "katex": "0.18.0",
    "tslib": "^2.8.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "description": "File-backed collaborative Tiptap Markdown editor for Project Workbenches",
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "markdown_editor",
      "runtimePolicy": {
        "install": "restart",
        "update": "restart",
        "uninstall": "restart"
      }
    }
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@xpert-ai/contracts": "^3.27.0",
    "@xpert-ai/plugin-sdk": "^3.27.0",
    "typeorm": "^0.3.24",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@tailwindcss/cli": "4.3.2",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-collaboration-caret": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@xpert-ai/contracts": "3.27.0",
    "@xpert-ai/plugin-sdk": "3.27.0",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "0.28.1",
    "playwright-core": "^1.55.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "socket.io-client": "4.8.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.20.6",
    "typeorm": "^0.3.24",
    "typescript": "5.9.3",
    "zod": "3.25.67"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "xpertai/apps/markdown-editor"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "@xpert-ai/plugin-markdown-editor"
  }
}

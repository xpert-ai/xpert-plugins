{
  "name": "@xpert-ai/plugin-code-review",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "description": "Version-aware pull request review and findings workspace for Xpert",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "code_review"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.remote.json",
    "test": "tsx --test tests/*.test.ts",
    "verify:dist": "node scripts/build.mjs --check"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/contracts": "^3.19.0",
    "@xpert-ai/plugin-sdk": "^3.19.0",
    "zod": "3.25.67",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@tailwindcss/cli": "4.3.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@xpert-ai/contracts": "3.19.0",
    "@xpert-ai/plugin-sdk": "3.19.0",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "0.28.1",
    "lucide-react": "1.24.0",
    "playwright-core": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "socket.io-client": "4.8.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod": "3.25.67",
    "@nestjs/typeorm": "^11.0.0",
    "typeorm": "^0.3.24",
    "yaml": "^2.8.1"
  }
}

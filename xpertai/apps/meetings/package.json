{
  "name": "@xpert-ai/plugin-meetings",
  "version": "0.1.0",
  "description": "Private file-backed meeting notes for Xpert Desktop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "scripts/live-smoke.mjs",
    "scripts/live-collaboration.mjs",
    ".xpertai-plugin",
    "README.md",
    "scripts/live-assistant.mjs",
    "scripts/live-workspace.mjs",
    "docs/assistant-summaries.md",
    "docs/realtime-collaboration.md",
    "docs/development-plan.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.remote.json",
    "verify:dist": "node scripts/build.mjs --check",
    "test": "tsx --test tests/*.test.ts",
    "preview": "node ../../../tools/remote-view-preview/cli.mjs --config remote-components/meetings/preview.config.mjs --port 4417",
    "verify:desktop": "node scripts/verify-desktop-capture.mjs",
    "prepack": "node scripts/build.mjs --check",
    "verify:capture-feedback": "node scripts/verify-capture-feedback.mjs"
  },
  "xpert": {
    "plugin": {
      "level": "system",
      "artifactNamespace": "meetings"
    }
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "proper-lockfile": "4.1.2",
    "tslib": "^2.8.1",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.27"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/contracts": "^3.19.0",
    "@xpert-ai/plugin-sdk": "^3.19.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@tailwindcss/cli": "4.3.2",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@types/node": "^22.13.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@xpert-ai/contracts": "3.19.0",
    "@xpert-ai/plugin-sdk": "3.19.0",
    "@xpert-ai/plugin-shadcn-ui": "workspace:*",
    "esbuild": "0.28.1",
    "lucide-react": "1.24.0",
    "playwright-core": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "0.2.2",
    "socket.io-client": "4.8.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod": "3.25.67"
  },
  "author": {
    "name": "XpertAI",
    "url": "https://xpertai.cn"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins",
    "directory": "xpertai/apps/meetings"
  },
  "bugs": {
    "url": "https://github.com/xpert-ai/xpert-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "verify:dist": {
        "cache": false
      }
    }
  }
}

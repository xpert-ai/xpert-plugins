{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "customConditions": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [],
  "exclude": [
    "src/**/*.spec.ts",
    "src/lib/remote-components/**"
  ]
}

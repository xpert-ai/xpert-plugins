{
  "name": "@xpert-ai/plugin-maps",
  "projectType": "library",
  "sourceRoot": "apps/maps/src",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node --test tests/*.test.mjs",
        "cwd": "apps/maps"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node scripts/browser-smoke.mjs",
        "cwd": "apps/maps"
      }
    },
    "build-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/build-mcp-app.mjs",
        "cwd": "apps/maps"
      }
    }
  }
}

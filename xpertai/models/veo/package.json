  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "test": "pnpm run build && jest --config jest.config.cjs && tsc -p tsconfig.spec.json --noEmit",
    "typecheck": "pnpm run build && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/plugin-sdk": "^3.6.1",
    "zod": "3.25.67"

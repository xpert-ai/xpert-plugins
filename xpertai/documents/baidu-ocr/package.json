{
  "name": "@xpert-ai/plugin-baidu-ocr",
  "version": "0.1.0",
  "description": "Baidu Cloud PaddleOCR-VL and Unlimited-OCR document converter plugin for XpertAI.",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "xpertai/documents/baidu-ocr"
  },
  "bugs": {
    "url": "https://github.com/xpert-ai/xpert-plugins/issues"
  },
  "homepage": "https://github.com/xpert-ai/xpert-plugins/tree/main/xpertai/documents/baidu-ocr#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "xpert": {
    "plugin": {
      "level": "organization"
    }
  },
  "dependencies": {
    "image-size": "1.2.1",
    "pdf-lib": "1.17.1",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.72",
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/contracts": "^3.10.0",
    "@xpert-ai/plugin-sdk": "^3.15.15",
    "axios": "^1.12.2",
    "uuid": "8.3.2",
    "zod": "3.25.67"
  }
}

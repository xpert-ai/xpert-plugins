{
  "name": "@xpert-ai/plugin-anydoc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "documents/anydoc/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project @xpert-ai/plugin-anydoc --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "cwd": "documents/anydoc",
        "command": "tsc -p tsconfig.lib.json && node scripts/build-sandbox-action.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "documents/anydoc",
        "command": "node --test tests/*.test.mjs"
      },
      "dependsOn": [
        "build"
      ]
    }
  }
}

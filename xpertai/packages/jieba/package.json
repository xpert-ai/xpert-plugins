{
  "name": "@xpert-ai/plugin-jieba",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0",
    "@node-rs/jieba": "2.0.3"
  },
  "description": "Jieba Chinese keyword analyzer for Xpert knowledgebases.",
  "license": "AGPL-3.0",
  "author": "XpertAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/xpert-ai/xpert-plugins.git",
    "directory": "xpertai/packages/jieba"
  },
  "publishConfig": {
    "access": "public"
  },
  "xpert": {
    "plugin": {
      "level": "organization"
    }
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/plugin-sdk": "^3.18.6",
    "zod": "^3.25.67"
  },
  "private": true
}

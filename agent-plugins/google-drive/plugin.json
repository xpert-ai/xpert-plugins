{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "google-drive",
  "version": "1.0.0",
  "description": "Read and update Google Drive, Docs, Sheets, and Slides the connected account can access. Complements the local documents, pdf, presentations, and spreadsheets packages.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://developers.google.com/workspace",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "Google Drive",
        "icon": "data:image/svg+xml;base64,"
      },
      "connectors": {
        "google-drive": {
          "type": "mcp_oauth"
        },
        "google-docs": {
          "type": "mcp_oauth"
        },
        "google-sheets": {
          "type": "mcp_oauth"
        },
        "google-slides": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}

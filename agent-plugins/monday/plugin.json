{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "monday",
  "version": "1.0.0",
  "description": "Search and work with boards, items, and docs in the monday.com account the connected user can access, using monday.com's official remote MCP server.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://developer.monday.com/api-reference/docs/mondaycom-mcp",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "monday.com",
        "icon": "https://cdn.monday.com/images/logos/monday_logo_icon.png"
      },
      "connectors": {
        "monday": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}

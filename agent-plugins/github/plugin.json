{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "github",
  "version": "1.0.0",
  "description": "Search and work with repositories, issues, and pull requests the connected GitHub account can access, using GitHub's official remote MCP server.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://github.com/github/github-mcp-server",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "GitHub",
        "icon": "data:image/svg+xml;base64,"
      },
      "connectors": {
        "github": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}

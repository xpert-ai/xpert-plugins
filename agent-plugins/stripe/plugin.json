{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "stripe",
  "version": "1.0.0",
  "description": "Read the connected Stripe account and run only the API writes the user requested, using Stripe's official remote MCP server.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://docs.stripe.com/mcp",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "Stripe",
        "icon": "https://stripe.com/favicon.ico"
      },
      "connectors": {
        "stripe": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}

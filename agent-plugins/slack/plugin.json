{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "slack",
  "version": "1.0.0",
  "description": "Search and work in Slack channels the connected user can access, using Slack's official remote MCP server.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://docs.slack.dev/ai/slack-mcp-server/",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "Slack",
        "icon": "data:image/svg+xml;base64,"
      },
      "connectors": {
        "slack": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}

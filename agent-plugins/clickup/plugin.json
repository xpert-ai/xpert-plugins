{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "clickup",
  "version": "1.0.0",
  "description": "Search and work with tasks, docs, and the workspace hierarchy the connected ClickUp user can access, using ClickUp's official remote MCP server.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://developer.clickup.com/docs/connect-an-ai-assistant-to-clickups-mcp-server",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "ClickUp",
        "icon": "data:image/png;base64,"
      },
      "connectors": {
        "clickup": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "canva",
  "version": "1.0.0",
  "description": "Search and work with designs in the connected user's global Canva account, using Canva's official remote MCP server. This package does not replace canva-cn.",
  "author": {
    "name": "Xpert AI"
  },
  "homepage": "https://www.canva.dev/docs/mcp/",
  "extensions": {
    "xpertai": {
      "version": 1,
      "interface": {
        "displayName": "Canva",
        "icon": "data:image/png;base64,"
      },
      "connectors": {
        "canva-global": {
          "type": "mcp_oauth"
        }
      }
    }
  }
}
